#nop {Sakra - converted from jmc3714/sakra.set}

#variable {food} {meat}
#variable {foodsource} {all}
#variable {drink} {flask}
#variable {leader} {Bughuul}
#variable {target} {elf}

#alias {at} {ambush troll}
#alias {aw} {ambush wolf}
#alias {qq} {un stonedoor;op stonedoor}
#alias {cotton} {rem all.chain;rem all.mithril;wear all.cotton;wear 2.boots;wear mask;wear shiny}
#alias {metal} {rem all.cotton;rem shiny;rem mask;rem boots;wear all.chain;wear all.mithril}
#alias {stab} {wie pale;wear banner}
#alias {wb} {rem shield;wie bow;wear quiver}
#alias {reload} {rem quiver;g all.arrow pack;pu all.arrow quiver;wear quiver}
#alias {rs} {rem shield}
#alias {wsh} {wear shield}
#alias {mine} {gr axe;g all;gr canteen;pu all.gem sac;pu all.nug sac}
#alias {m} {mark $target}
#alias {k2} {k 2.$target}
#alias {v} {bash $target}
#alias {vv} {bash 2.$target}
#alias {z} {cas 'curse' $target}
