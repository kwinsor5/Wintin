#nop {Vraurk - converted from jmc3714/vraurk.set}

#variable {food} {meat}
#variable {foodsource} {all}
#variable {drink} {flask}
#variable {leader} {Skagrat}
#variable {target} {troll}

#alias {aa} {cl heavydoor;lock heavydoor}
#alias {qq} {un heavydoor;op heavydoor}
#alias {cotton} {wear crown;wear boots;rem all.obsidian}
#alias {metal} {wear all.obsidian}
#alias {stab} {rem hammer;wie dragon}
#alias {rs} {rem shield}
#alias {wsh} {wear shield}
#alias {kt} {k troll}
#alias {kw} {k wolf}
#alias {k2} {k 2.$target}
#alias {v} {bash $target}
#alias {vv} {bash 2.$target}
#alias {z} {cas 'curse' $target}

#alias {autobashon} {#action {has recovered from a bash!} {bash}}
#alias {autobashoff} {#unaction {has recovered from a bash!}}

#nop {Auto-attack now lives in bin/auto-attack.tin and is switched with the}
#nop {auto-attack-on / auto-attack-off aliases in global.tin, so it is}
#nop {available to every character rather than just this one.}

#action {Ufdirg says 'bash'} {bash} {5}

#nop {=== Hotkeys (imported from JMC) ===}

#nop {TAB attacks the current target, as in JMC; it replaces tab completion.}

#macro {\t} {cas 'dark bolt' $target}
