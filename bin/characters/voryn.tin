#nop {Voryn - converted from jmc3714/voryn.set}

#variable {food} {way}
#variable {foodsource} {all}
#variable {drink} {water}
#variable {leader} {Dev}
#variable {target} {goblin}

#read {classes/mystic.tin}

#alias {qq} {cas 'poison' $target}
#alias {z} {cas 'curse' $target}
#alias {cotton} {rem all.chain;wear all.cotton;wear fillet;wear 2.boots}
#alias {metal} {rem all.cotton;rem fillet;rem boots;wear all.chain}
#alias {mine} {gr axe;gr sceptre;g all}

#nop {=== Hotkeys (imported from JMC) ===}

#nop {TAB attacks the current target, as in JMC; it replaces tab completion.}

#macro {\t} {cas 'curing saturation' $target}
