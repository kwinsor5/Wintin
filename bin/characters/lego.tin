#nop {Lego - converted from jmc3714/lego.set}

#variable {food} {way}
#variable {foodsource} {all}
#variable {drink} {water}
#variable {leader} {Fimli}
#variable {target} {wolf}

#alias {aa} {cl heavydoor;lock heavydoor}
#alias {qq} {un heavydoor;op heavydoor}
#alias {at} {ambush troll}
#alias {aw} {ambush wolf}
#alias {kb} {k bear}
#alias {kt} {k troll}
#alias {kw} {k wolf}
#alias {buff} {wie short;wear shield;rem all.amulet;wear all.medal}
#alias {hit} {rem shield;wie greatsword;rem all.medal;wear all.amulet}
#alias {cotton} {wear helm;wear all.spidersilk;one;wear arm;tw}
#alias {metal} {wear all.mail}
#alias {spear} {rem shield;wie ash}
#alias {rs} {rem shield}
#alias {wsh} {wear shield}
#alias {v} {bash $target}
#alias {vv} {bash 2.$target}
#alias {vvv} {bash 3.$target}

#action {You have been} {afk} {5}
#action {attacks Covid!} {resc Covid} {5}
