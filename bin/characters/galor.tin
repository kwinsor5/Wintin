#nop {Galor - converted from jmc3714/galor.set}

#variable {food} {way}
#variable {foodsource} {all}
#variable {drink} {water}
#variable {leader} {Nina}
#variable {target} {olog}

#alias {a} {cas 'fireball' $target}
#alias {aa} {cas 'chill ray' $target}
#alias {h} {cas 'hallucinate' $target}
#alias {itt} {cas 'insight' $target}
#alias {pp} {cas 'poison' $target}
#alias {z} {cas 'curse' $target}
#alias {cotton} {wear all.cotton;wear sleeves;wear boots}
#alias {metal} {wear all.chain}
#alias {mine} {gr pickaxe;gr fang;g all;pu all.gem sack}

#action {You have been} {afk} {5}

#nop {=== Hotkeys (imported from JMC) ===}

#nop {TAB attacks the current target, as in JMC; it replaces tab completion.}

#macro {\t} {cas 'lightning bolt' $target}
