#nop {Urgog - converted from jmc3714/urgog.set}

#variable {food} {meat}
#variable {foodsource} {all}
#variable {drink} {flask}
#variable {leader} {Terror}
#variable {target} {tree}

#alias {a} {cas 'spear of darkness' $target}
#alias {aa} {cas 'word of agony' $target}
#alias {m} {cas 'word of pain' $target}
#alias {v} {cas 'black arrow' $target}
#alias {z} {cas 'curse' $target}
#alias {cotton} {rem all.chain;wear all.cotton;wear 2.boots;wear mask;wear shiny}
#alias {metal} {rem all.cotton;rem shiny;rem mask;rem boots;wear all.chain}

#action {You have been} {afk} {5}
#action {^Str: %1/%2, Int: %3/%4, Wil: %5/%6, Dex: %7/%8, Con: %9/%10, Lea: %11/%12.} {#math {statsum} {%1 + %3 + %5 + %7 + %9 + %11};#showme {<faa>Stat Sum: $statsum}} {5}

#nop {=== Hotkeys (imported from JMC) ===}

#nop {TAB attacks the current target, as in JMC; it replaces tab completion.}

#macro {\t} {cas 'dark bolt' $target}
