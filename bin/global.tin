#nop {Global configuration. Loaded for every session, before any character file.}
#nop {Character files are loaded after login and override the variables below.}

#nop {=== Variables (fallbacks; character files should override) ===}

#variable {food} {way}
#variable {foodsource} {all}
#variable {drink} {skin}

#nop {=== Triggers ===}

#action {You are hungry.} {get $food $foodsource;eat $food} {5}
#action {You are thirsty.} {#2 {drink $drink}} {5}

#nop {No default leader: an empty value would make these patterns match any line.}

#action {$leader attacks} {assist $leader} {5}
#action {$leader leaps} {assist $leader} {5}
#action {$leader mounts} {ride} {5}
#action {$leader stops riding} {dism} {5}

#nop {=== Aliases ===}

#nop {Parameterised target selection replaces the per-mob aliases used in JMC.}
#alias {targ} {#var {target} {%1}}

#alias {j} {k $target}
#alias {jj} {k 2.$target}
#alias {jjj} {k 3.$target}
#alias {q} {assist $leader}

#nop {Self-heals, kept global rather than in classes/whitie-mage.tin because every}
#nop {caster wants them. Full "cast" and the quoted spell name on purpose: the}
#nop {skill timer works the total out from the command that goes over the wire,}
#nop {and an in-game alias is expanded server side so it never reaches the}
#nop {client. %0 passes the rest of the line through - without it tintin}
#nop {silently drops anything typed after the alias.}

#alias {cs} {cast 'cure self' %0}
#alias {vs} {cast 'vitalize self' %0}

#alias {autofleeon} {#action {PANIC!} {flee}}
#alias {autofleeoff} {#unaction {PANIC!}}

#alias {rescueon} {#action {turns to fight %1!} {rescue %1}}
#alias {rescueoff} {#unaction {turns to fight %1!}}
#alias {rescon} {rescueon}
#alias {rescoff} {rescueoff}

#nop {=== Substitutions ===}

#nop {Room-exit annotations, toggled on demand.}

#alias {farothon} {#substitute {Taur-en-Faroth} {Taur-en-Faroth: en M:swwnnwnw C:nwnwnnnn}}
#alias {farothoff} {#unsubstitute {Taur-en-Faroth}}

#alias {valeon} {#substitute {Accursed Vale} {Accursed Vale    Exits are: N E - Entrance: nwsew};#substitute {Dim Vale} {Dim Vale    Exits are: S W - Entrance: snnw};#substitute {Entrance to the Hidden Vale} {Entrance to the Hidden Vale    Exits are: E W - Entrance: };#substitute {Leaving the Hidden Vale} {Leaving the Hidden Vale    Exits are: E W - Entrance: wnnnnww}}
#alias {valeoff} {#unsubstitute {Accursed Vale};#unsubstitute {Dim Vale};#unsubstitute {Entrance to the Hidden Vale};#unsubstitute {Leaving the Hidden Vale}}

#nop {=== Theme ===}

#nop {One palette table drives every colour in this file: channel highlights,}
#nop {HUD bars, panel frames, the input line, the in-game colour slots and the}
#nop {terminal itself. Entries are bare RRGGBB so one value serves as a <F...>}
#nop {tag, as the mintty OSC 10/11/12 escape and as "color <slot> fg hex".}
#nop {"theme light" / "theme dark" swap the table and repaint; "themetoggle"}
#nop {flips. $theme is the startup default (dark, Kenny 2026-09-04) - it is}
#nop {applied at the end of the file.}

#nop {Light: dark, muted tones for the light grey mintty background with dark}
#nop {blue default text - violet tells, teal says, amber chats. Dark: the same}
#nop {hues lifted for a warm near-black background with off-white text, silver}
#nop {frames, and plain panel text in the same off-white as the main feed.}

#nop {Keys: edge = panel frames, baredge = the border row above the input,}
#nop {ink = typed text, text = plain panel text (time, HUD captions, banner}
#nop {level line), mute = command echo / enemy slot, empty = the ░ half of a}
#nop {bar, band = the blended colour that ░ shows, pctbg = 1 to paint the}
#nop {in-bar percentage over a matching background (0 = none: leaves a gap).}

#variable {theme} {dark}

#alias {theme} {
	#if {"%1" == "dark"} {
		#var {theme} {dark};
		#var {pal} {
			{bg} {1F1E1D} {fg} {E8E6DC} {cursor} {B0B0B0}
			{tell} {B48BE8} {say} {3FBFBF} {chat} {E0A040} {gsay} {E06060}
			{narr} {D86ED8} {whis} {6FCF6F} {page} {E080B0}
			{hp} {E05050} {st} {6C8CF0} {mv} {4FC04F}
			{boss} {FF6B6B} {bossedge} {E8B830}
			{head} {E0B040} {edge} {C0C0C0} {baredge} {C0C0C0}
			{ink} {A8B8F0} {text} {E8E6DC} {mute} {A0A0A0} {empty} {4A4A4A}
			{pctfill} {FFFFFF} {pctempty} {E8E6DC} {band} {292928} {pctbg} {1}
			{char} {5AD65A} {hit} {4CBF4C}
			}
		} {
		#var {theme} {light};
		#var {pal} {
			{bg} {C0C0C0} {fg} {0000A0} {cursor} {7F7F7F}
			{tell} {5B2D91} {say} {005F5F} {chat} {7A4B00} {gsay} {992222}
			{narr} {8B2E8B} {whis} {1E5E1E} {page} {993366}
			{hp} {992222} {st} {2244AA} {mv} {1E7A1E}
			{boss} {6B1111} {bossedge} {B8860B}
			{head} {806100} {edge} {101040} {baredge} {404040}
			{ink} {101040} {text} {404040} {mute} {404040} {empty} {909090}
			{pctfill} {FFFFFF} {pctempty} {000000} {band} {B4B4B4} {pctbg} {1}
			{char} {228B22} {hit} {1F751F}
			}
		};
	themeapply
	}

#alias {themetoggle} {
	#if {"$theme" == "dark"} {
		theme light
		} {
		theme dark
		}
	}

#nop {Everything that bakes a colour in at definition time is redone here. The}
#nop {OSC 11/10/12 escapes recolour mintty's background, text and cursor. They}
#nop {only reach the terminal while no scroll region is set - inside one tintin}
#nop {redraws #showme output itself and drops the escapes - so the region is}
#nop {dropped first and relayout (which clears the screen) puts it back.}

#alias {themeapply} {
	#var {paneledge} {<F$pal[edge]>};
	#var {panelhead} {<F$pal[head]>};
	#config {COMMAND COLOR} {<F$pal[ink]>};
	themehighlights;
	#screen {scrollregion} {0} {0} {0} {0};
	#showme {\e]11;#$pal[bg]\a\e]10;#$pal[fg]\a\e]12;#$pal[cursor]\a};
	relayout;
	#showme {${panelhead}Theme: $theme}
	}

#nop {%%1 keeps the %1 wildcards out of the alias's own argument substitution.}
#nop {The socials panel actions below use the same entries so both views match.}

#alias {themehighlights} {
	#highlight {HP: %%1/%%2 } {<F$pal[hp]>};
	#highlight {S: %%1/%%2 } {<F$pal[st]>};
	#highlight {MV: %%1/%%2]} {<F$pal[mv]>};
	#highlight {You tell %%1} {<F$pal[tell]>};
	#highlight {%%1 tells you '%%2} {<F$pal[tell]>};
	#highlight {You narrate '%%1} {<F$pal[narr]>};
	#highlight {%%1 narrates '%%2} {<F$pal[narr]>};
	#highlight {You chat '%%1} {<F$pal[chat]>};
	#highlight {%%1 chats '%%2} {<F$pal[chat]>};
	#highlight {You say '%%1} {<F$pal[say]>};
	#highlight {%%1 says '%%2} {<F$pal[say]>};
	#highlight {You group-say '%%1} {<F$pal[gsay]>};
	#highlight {%%1 group-says '%%2} {<F$pal[gsay]>};
	#highlight {You yell '%%1} {<F$pal[tell]>};
	#highlight {%%1 yells '%%2} {<F$pal[tell]>}
	}

#nop {=== Highlights ===}

#nop {JMC black backgrounds are dropped. The prompt-field and channel}
#nop {highlights live in themehighlights (Theme section) so the toggle can}
#nop {redefine them; the prompt fields carry the same colours as their HUD bars.}

#highlight {%1 appears to be confused!} {magenta}
#highlight {%1 nervously glances around in confusion!} {green}
#highlight {You stagger %1 with your crushing blow!} {light cyan}
#highlight {You hunker down behind your shield.} {yellow}

#highlight {%1 attacks a war orc!} {magenta}
#highlight {%1 attacks an orcish lieutenant!} {magenta}
#highlight {A heavily built and tattooed war orc sneers at you.} {Ebony}
#highlight {An orcish lieutenant stands at attention here.} {Ebony}

#highlight {A %1 looks healthy.} {magenta}
#highlight {A %1 has some scratches.} {magenta}
#highlight {A %1 has some bruises.} {magenta}
#highlight {A %1 has a lot of wounds.} {magenta}
#highlight {A %1 is almost dead.} {magenta}
#highlight {An %1 looks healthy.} {magenta}
#highlight {An %1 has some scratches.} {magenta}
#highlight {An %1 has some bruises.} {magenta}
#highlight {An %1 is somewhat hurt.} {magenta}
#highlight {An %1 has a lot of wounds.} {magenta}
#highlight {An %1 is almost dead.} {magenta}

#highlight {A huge boulder looks as though it could fall at any moment.} {light red}
#highlight {A huge boulder leans dangerously close to the edge and will fall any second.} {light red}

#nop {Channel colouring, replacing the JMC #woutput windows.}

#nop {=== Events ===}

#nop {Paced like human typing: the server hides input at the password prompt}
#nop {(telnet echo off) and unhides it after reading the password. Sending all}
#nop {three answers at once races that negotiation and can leave the client}
#nop {stuck with typing invisible, so each answer waits for its prompt.}

#nop {$rots_account and $rots_password are NOT defined in any .tin file. The}
#nop {launcher (bin/wintin.ps1) decrypts bin/credentials.asc with gpg into the}
#nop {ROTS_ACCOUNT / ROTS_PASSWORD environment variables and passes them to}
#nop {tt++ with -e "#variable ..." before main.tin is read, so the startup}
#nop {session already holds them and the game session inherits them.}

#event {SESSION CONNECTED} {
	#delay {.5} {
		#send {$rots_account}
		};
	#delay {1} {
		#send {$rots_password}
		};
	#delay {1.5} {
		#send {2}
		}
	}

#nop {The server pushes MSDP CHARACTER_NAME once the character enters the game.}
#nop {Killing the class first keeps one character's settings from leaking into another.}

#nop {Role-dependent HUD options are reset to their defaults BEFORE the}
#nop {character file is read, so a setting made by one character's profile}
#nop {cannot leak into the next character logged in.}

#alias {loadchar} {#class {character} {kill};#var {hudmage} {0};#var {hudmystic} {0};#class {character} {read} {characters/%1.tin};#showme {${panelhead}Loaded profile: %1}}

#nop {The mapper is switched on at the same moment (map-on only if it is not}
#nop {already loaded, so a repeat CHARACTER_NAME push cannot reset a walk or}
#nop {the mapping toggle). map-off still turns it off for the session.}

#event {IAC SB MSDP CHARACTER_NAME} {
	#showme {${panelhead}MSDP character: %1};
	loadchar %1;
	#class {mapper} {size} {mapcount};
	#if {$mapcount == 0} {map-on}
	}

#nop {=== In-game colours ===}

#nop {The server supports truecolour per colour slot (src/color.cpp do_color):}
#nop {color <slot> fg hex RRGGBB. colorsync pushes the client palette into the}
#nop {game so server-coloured text matches the highlights above. Channel slots}
#nop {get their exact channel colours; the rest map their stock ANSI family to}
#nop {the palette's equivalent (cyan->say, red->hp, yellow->chat, magenta->narr,}
#nop {bright white->mute); character gets its own brighter green with hit a}
#nop {step dimmer, description the whisper green. Values come from $pal, so}
#nop {the game palette follows whichever theme is active when this runs.}
#nop {Settings persist server-side per character, so run colorsync by hand once}
#nop {per character (and again after switching theme). Deliberately not}
#nop {automated: login/reconnect text triggers also matched logout output.}

#alias {colorsync} {
	color on;
	color say fg hex $pal[say];
	color tell fg hex $pal[tell];
	color yell fg hex $pal[tell];
	color narrate fg hex $pal[narr];
	color chat fg hex $pal[chat];
	color group fg hex $pal[gsay];
	color roomname fg hex $pal[say];
	color hit fg hex $pal[hit];
	color damage fg hex $pal[hp];
	color character fg hex $pal[char];
	color object fg hex $pal[say];
	color enemy fg hex $pal[mute];
	color description fg hex $pal[whis];
	color magic fg hex $pal[narr];
	color weather fg hex $pal[say]
	}

#nop {=== Panels ===}

#nop {A boxed column down the right hand side, split in half: socials in the top}
#nop {box, MSDP in the bottom box. Either half can be turned off, in which case the}
#nop {other takes the whole column.}

#nop {The column is kept still by #screen scrollregion. #split is also applied,}
#nop {but only to give the input line its own fixed bottom row: without split,}
#nop {typing happens inline in the output stream, so the server's colour state}
#nop {bleeds onto individual letters and incoming lines land on top of what is}
#nop {being typed. #split runs "#screen fill default" every time it is applied,}
#nop {which would erase the right hand bar - so relayout applies it FIRST and}
#nop {paints the panels afterwards. The one-line bar #split reserves above the}
#nop {input acts as the visual border between the feed and the input row.}

#nop {Mouse tracking is on so that the wheel is handled here rather than by mintty.}
#nop {Scrolling mintty's own scrollback would move the whole screen, panels and all.}

#nop {Tracking also means a plain click-drag goes to tintin, not to mintty's text}
#nop {selection. To select text: hold SHIFT while dragging (shift+double-click}
#nop {selects a word), then ctrl+ins copies and shift+ins pastes. When a lot of}
#nop {copying is needed, copyon turns tracking off so plain drag selects again -}
#nop {the wheel then scrolls the whole screen instead of the panels - and}
#nop {copyoff restores panel scrolling.}

#nop {Selecting within ONE panel: the terminal is a single text grid, so a normal}
#nop {selection sweeps whole rows, panels included. Add ALT for mintty's}
#nop {rectangular selection - shift+alt+drag (alt+drag after copyon) - and the}
#nop {highlight stays inside the dragged box: main feed only, or one panel only.}

#config {MOUSE} {ON}

#alias {copyon} {
	#config {MOUSE} {OFF};
	#showme {${panelhead}Mouse tracking off: drag to select, ctrl+ins to copy. copyoff restores panel scrolling.}
	}

#alias {copyoff} {
	#config {MOUSE} {ON};
	#showme {${panelhead}Mouse tracking on: panels scroll again; hold shift to select.}
	}

#variable {socpanel} {1}
#variable {msdppanel} {1}
#variable {pancols} {60}
#variable {sochist} {300}
#variable {panscrolllines} {3}

#nop {Left column: an Info box in the top half and the MSDP-fed HUD below,}
#nop {mirroring the right column's split. leftcols is in character cells;}
#nop {50 cells is roughly 400px at a typical mintty font. leftpanelwidth <n>}
#nop {changes it, lefton/leftoff toggle the whole column. padcols is the}
#nop {gap between the column and the main feed - a cell is the smallest}
#nop {unit the terminal has, so 1 is the least padding possible.}

#nop {Terminals cannot show a raster image in a panel - mintty's own sixel}
#nop {graphics are addressed in pixels and would be wiped by the next panel}
#nop {repaint - so the combat marker is a single glyph beside the bar. A}
#nop {glyph cannot be scaled either: every cell is one font size, and cell}
#nop {art spanning several rows read as an X rather than as swords.}

#variable {hudswords} {⚔}

#nop {=== Experimental: hardware side margins ===}

#nop {Tintin confines output to a column range in SOFTWARE - it only ever}
#nop {emits DECSTBM row margins, never DECSLRM column margins - and to do}
#nop {that it redraws the current line whenever it grows. That is what}
#nop {smears the cast spinner, which arrives as bare \r|\r with no newline.}

#nop {With hwmargins on, the scroll region is dropped and the TERMINAL is}
#nop {asked to keep the scrolling inside the feed columns instead, via}
#nop {DECLRMM (\e[?69h) and DECSLRM (\e[left;rights). Tintin then writes}
#nop {incrementally the way it does with no region at all, so the spinner}
#nop {animates - if mintty honours those sequences. Try marginson; if the}
#nop {feed spills over the panels, marginsoff restores the software scroll}
#nop {region.}

#nop {THE TRADE: margin mode animates the spinner but gives up the reserved}
#nop {input row, because it cannot use #split - split mode writes every line}
#nop {at column 1 and ignores the left margin. Typing then happens inline in}
#nop {the feed. Off by default for that reason; the panels and a proper}
#nop {input line are worth more than the wheel. Turn the wheel off in game}
#nop {with "set spinner" to keep the feed clean.}

#variable {hwmargins} {0}

#alias {marginson} {
	#var {hwmargins} {1};
	relayout;
	#showme {${panelhead}Hardware margins on - the spinner should animate. marginsoff to revert.}
	}

#alias {marginsoff} {
	#var {hwmargins} {0};
	relayout;
	#showme {${panelhead}Hardware margins off - back to the software scroll region.}
	}

#nop {Boss banner: a panel across the top of the feed, used instead of the left}
#nop {column's Opponent box when the foe is above bossmin. bosspct is its share}
#nop {of the feed width - 100 spans the feed edge to edge, anything less is}
#nop {centred in it. bossrows is its total height including the border:}
#nop {1 border, 3 bar (percentage on the middle row), 1 name, 1 level, 1 border.}

#variable {bosspanel} {1}
#variable {bossmin} {25}
#variable {bosspct} {100}
#variable {bossrows} {7}
#variable {bosson} {0}
#variable {bosscolsw} {30}
#variable {bossleft} {1}
#variable {bossright} {1}
#variable {bosswidth} {1}
#variable {bossfmt} {%-1.1s}
#variable {bossblank} {}
#variable {bossfeedblank} {}
#variable {bosschunkw} {12}
#variable {bosscolx} {0}
#variable {bossn} {0}
#variable {bossk} {0}
#variable {bossfullbar} {}
#variable {bossemptybar} {}
#variable {bossfullpre} {}
#variable {bossemptypre} {}
#variable {bossname} {}
#variable {bosslvl} {0}
#variable {bosshp} {0}
#variable {bosswant} {0}
#variable {bossfill} {0}
#variable {bossrest} {0}
#variable {bossrow} {0}
#variable {bosscol} {0}
#variable {bossbot} {0}
#variable {bosspad} {0}
#variable {bossclen} {0}
#variable {bosspadstr} {}
#variable {bosscentered} {}
#variable {bosspcttext} {}
#variable {bosspctcol} {0}
#variable {bosspctcolor} {}
#variable {bosstopr} {1}

#variable {leftpanel} {1}
#variable {leftcols} {50}
#variable {padcols} {1}

#nop {Geometry, all recomputed by relayout.}

#variable {panleft} {1}
#variable {pancol} {1}
#variable {barrow} {1}
#variable {barline} {}
#variable {leftbot} {1}
#variable {panwidth} {1}
#variable {panfmt} {%-58.58s}
#variable {pannfmt} {%-22.22s}
#variable {panvfmt} {%-35.35s}
#variable {panblank} {}
#variable {socboxtop} {0}
#variable {socboxbot} {0}
#variable {msdpboxtop} {0}
#variable {msdpboxbot} {0}

#variable {soctop} {2}
#variable {soccap} {1}
#variable {socview} {0}
#variable {soclog} {}
#variable {soctmp} {}
#variable {soccolor} {}

#nop {msdp must exist as a table before the panel draws, or *msdp[] does not}
#nop {expand and #foreach iterates the literal text. Created only when absent:}
#nop {the server re-pushes a variable ONLY when its value changes, so wiping the}
#nop {cache on every re-read left the MSDP panel and HUD empty until something}
#nop {changed in game. A re-read now keeps the accumulated data.}

#nop {&{msdp} is 0 when the variable is missing; &msdp[] would stay literal.}

#if {&{msdp} == 0} {
	#variable {msdp} {}
	}

#variable {msdptop} {2}
#variable {msdpcap} {1}
#variable {msdpview} {0}
#variable {msdprow} {1}
#variable {msdpval} {}
#variable {msdpsub} {}

#variable {leftw} {0}
#variable {leftcol} {2}
#variable {leftwidth} {1}
#variable {leftfmt} {%-36.36s}
#variable {leftblank} {}
#variable {hudtop} {2}
#variable {opptop} {2}
#variable {hudbase} {2}
#nop {Class rows under OB/DB/PB. Each class profile switches on ITS OWN flag -}
#nop {classes/whitie-mage.tin sets hudmage (spell power and penetration),}
#nop {classes/mystic.tin sets hudmystic (willpower, spell save, spirit) - so a}
#nop {character that reads both profiles gets both rows, in either read order.}
#nop {With no flag set the row shows attack speed. One flag per class, never a}
#nop {shared "mode" variable: that was overwritten by whichever file read last.}
#nop {loadchar resets every flag before reading a character file.}

#variable {hudmage} {0}
#variable {hudmystic} {0}
#variable {hudspow} {0}
#variable {hudspen} {0}
#variable {hudwill} {0}
#variable {hudsave} {0}
#variable {hudspirit} {0}

#variable {hudbarw} {1}
#variable {hudfullpre} {}
#variable {hudemptypre} {}
#variable {hudbw} {1}
#variable {pctbtext} {}
#variable {pctblen} {0}
#variable {pctbpad} {0}
#variable {pctbcol} {0}
#variable {pctbcolor} {}
#variable {hudsuf} {}
#variable {hudsuflen} {0}
#variable {hudk} {0}
#variable {hudkw} {0}
#variable {hudkf} {0}
#variable {hudtnl} {0}
#variable {hudfullbar} {}
#variable {hudemptybar} {}

#nop {The input region and the border above it start where the main content}
#nop {does, so the left column can run to the bottom of the screen. NOTE:}
#nop {inside alias bodies every command needs its own trailing semicolon,}
#nop {#nop included - a missing one mangles the rest of the body.}

#alias {relayout} {
	#screen {get} {ROWS} {layrows};
	#screen {get} {COLS} {laycols};
	#split {0} {1};
	#math {panbot} {$layrows - 2};
	#math {barrow} {$layrows - 1};
	#var {leftbot} {$layrows};
	#math {panleft} {$laycols - $pancols + 1};
	#var {leftw} {0};
	#if {$leftpanel == 1} {
		#var {leftw} {$leftcols}
		};
	#math {scrollleft} {$leftw + 1 + $padcols};
	#if {$socpanel == 1 || $msdppanel == 1} {
		#math {scrollright} {$panleft - 1 - $padcols}
		} {
		#var {scrollright} {$laycols}
		};
	#math {barlen} {$scrollright - $scrollleft + 1};
	#var {barline} {};
	#loop {1} {$barlen} {barloop} {#var {barline} {$barline─}};
	#nop {In margin mode the scroll region is dropped so tintin writes the};
	#nop {way it does with no region at all - each line starting wherever};
	#nop {the cursor lands, which the terminal's left margin then decides.};
	#nop {It must NOT be a #split: split mode positions every line at column};
	#nop {1 with \e[1G, which ignores the margin and buries the start of each};
	#nop {line under the left panel. That also means margin mode cannot have};
	#nop {a reserved input row - see the note above marginson.};
	#nop {The banner is centred in the feed and its prefix tables are built the};
	#nop {same way the HUD's are, for the same byte-truncation reason.};
	#math {bosscolsw} {$barlen * $bosspct / 100};
	#if {$bosscolsw < 30} {
		#var {bosscolsw} {30}
		};
	#if {$bosscolsw > $barlen} {
		#var {bosscolsw} {$barlen}
		};
	#math {bossleft} {$scrollleft + ($barlen - $bosscolsw) / 2};
	#math {bossright} {$bossleft + $bosscolsw - 1};
	#math {bosswidth} {$bosscolsw - 2};
	#var {bossfmt} {%-${bosswidth}.${bosswidth}s};
	#format {bossblank} {$bossfmt} { };
	#format {bossfeedblank} {%-${barlen}.${barlen}s} { };
	#var {bossfullbar} {};
	#var {bossemptybar} {};
	#var {bossfullpre} {};
	#var {bossemptypre} {};
	#var {bossfullpre[0]} {};
	#var {bossemptypre[0]} {};
	#loop {1} {$bosswidth} {bossloop} {
		#var {bossfullbar} {$bossfullbar█};
		#var {bossemptybar} {$bossemptybar░};
		#var {bossfullpre[$bossloop]} {$bossfullbar};
		#var {bossemptypre[$bossloop]} {$bossemptybar}
		};
	#nop {The screen is about to be cleared, so the banner starts hidden and};
	#nop {bossdraw puts it back on the next MSDP update or panel repaint.};
	#var {bosson} {0};
	#if {$hwmargins == 1} {
		#screen {scrollregion} {0} {0} {0} {0}
		} {
		bossregion
		};
	#screen {inputregion} {$layrows} {$scrollleft} {$layrows} {$scrollright};
	#nop {Margins must be OFF for the clear, or it only reaches the feed and};
	#nop {whatever was already on the panel columns is stranded there.};
	#line {ignore} {#showme {\e[?69l}};
	#screen {clear} {ALL};
	#math {leftwidth} {$leftcols - 2};
	#var {leftfmt} {%-${leftwidth}.${leftwidth}s};
	#format {leftblank} {$leftfmt} { };
	#var {hudbarw} {$leftwidth};
	#nop {Every prefix of the bar is stored, not just the whole thing, because};
	#nop {#format's %%.Ns truncates by BYTES. The block glyphs are three bytes};
	#nop {each, so truncating a bar of them to N gave a third of the intended};
	#nop {width and split the last glyph in half. Indexing a prefix is exact};
	#nop {and costs nothing at draw time.};
	#var {hudfullbar} {};
	#var {hudemptybar} {};
	#var {hudfullpre} {};
	#var {hudemptypre} {};
	#var {hudfullpre[0]} {};
	#var {hudemptypre[0]} {};
	#loop {1} {$hudbarw} {hudloop} {
		#var {hudfullbar} {$hudfullbar█};
		#var {hudemptybar} {$hudemptybar░};
		#var {hudfullpre[$hudloop]} {$hudfullbar};
		#var {hudemptypre[$hudloop]} {$hudemptybar}
		};
	#math {pancol} {$panleft + 1};
	#math {panwidth} {$pancols - 2};
	#math {pannw} {$panwidth / 2};
	#if {$pannw > 22} {#var {pannw} {22}};
	#math {panvw} {$panwidth - $pannw - 1};
	#var {panfmt} {%-${panwidth}.${panwidth}s};
	#var {pannfmt} {%-${pannw}.${pannw}s};
	#var {panvfmt} {%-${panvw}.${panvw}s};
	#format {panblank} {$panfmt} { };
	#math {panmid} {$layrows / 2};
	#math {leftmid1} {$layrows * 40 / 100};
	#math {leftmid2} {$layrows * 60 / 100};
	#var {socboxtop} {0};
	#var {socboxbot} {0};
	#var {msdpboxtop} {0};
	#var {msdpboxbot} {0};
	#if {$socpanel == 1 && $msdppanel == 1} {
		#var {socboxtop} {1};
		#var {socboxbot} {$panmid};
		#var {msdpboxtop} {$panmid};
		#var {msdpboxbot} {$leftbot}
		};
	#if {$socpanel == 1 && $msdppanel == 0} {
		#var {socboxtop} {1};
		#var {socboxbot} {$leftbot}
		};
	#if {$socpanel == 0 && $msdppanel == 1} {
		#var {msdpboxtop} {1};
		#var {msdpboxbot} {$leftbot}
		};
	#if {$socpanel == 1} {
		#math {soctop} {$socboxtop + 1};
		#math {soccap} {$socboxbot - $socboxtop - 1}
		};
	#if {$msdppanel == 1} {
		#math {msdptop} {$msdpboxtop + 1};
		#math {msdpcap} {$msdpboxbot - $msdpboxtop - 1}
		};
	#math {opptop} {$leftmid1 + 2};
	#math {hudtop} {$leftmid2 + 2};
	#var {socview} {0};
	#var {msdpview} {0};
	#if {$hwmargins == 1} {
		#line {ignore} {#showme {\e[?69h\e[$scrollleft;${scrollright}s}}
		};
	pandraw
	}

#nop {Keystrokes echo on the input row in whatever colour the terminal last had}
#nop {active - tintin does not paint live typing itself. Every panel draw and}
#nop {every server line can leave a different colour active, which is why typed}
#nop {text came out yellow, green or blue depending on timing. inputpaint parks}
#nop {the colour state on very dark navy by repainting the border's last cell}
#nop {and leaving the navy tag as the final escape emitted. It runs after every}
#nop {draw and every received line/prompt, so whatever painted last, typing is}
#nop {always navy.}

#alias {inputpaint} {#line {ignore} {#showme {<F$pal[baredge]>─<F$pal[ink]>} {$barrow} {$laycols}}}

#nop {The border above the input doubles as the timer readout. pandraw calls}
#nop {this rather than drawing the line itself, so a repaint cannot wipe the}
#nop {figures mid-cast.}

#nop {The game's own spinner, rebuilt rather than captured. The server picks}
#nop {its glyph as wait_wheel[wait_value %% 8] (comm.cpp:377) from an array}
#nop {whose second half repeats the first, so it is really wait_value %% 4:}
#nop {0 is a bar, 1 a backslash, 2 a hyphen, 3 a slash. wait_value at the}
#nop {moment of the tick is the beats REMAINING, which is casty - castx, so}
#nop {the same figure that drives the count drives the glyph and the sequence}
#nop {comes out identical to the wire. Verified: a 16 beat cast reproduces}
#nop {/-\|/-\|/-\|/-\ exactly, matching what other clients print inline.}
#nop {The backslash MUST be written doubled or tintin stores nothing.}

#variable {castwheel[0]} {|}
#variable {castwheel[1]} {\\}
#variable {castwheel[2]} {-}
#variable {castwheel[3]} {/}
#variable {castspin} {}
#variable {castwi} {0}
#variable {castxs} {0}

#alias {castdraw} {
	#line {ignore} {#showme {<F$pal[baredge]>$barline} {$barrow} {$scrollleft}};
	#if {$casty > 0} {
		#nop {castx is the beat BEING served, counting from 1, so the figure};
		#nop {starts on 1 the moment the command goes out and lands on the};
		#nop {listed total on the last beat.};
		#nop {No glyph on the last beat or during the hold: the server stops};
		#nop {sending the wheel once no beats remain, and that stillness is the};
		#nop {cue that the action is landing.};
		#if {$castx < $casty && $castheld == 0} {
			#math {castwi} {($casty - $castx) % 4};
			#var {castspin} {$castwheel[$castwi]}
			} {
			#var {castspin} { }
			};
		#nop {Spinner first, then the count. The beat stays padded to two};
		#nop {columns so "of N" does not shift right when the count crosses ten.};
		#format {castxs} {%+2s} {$castx};
		#format {casttext} { %s  %s of %s } {$castspin} {$castxs} {$casty};
		#math {castcol} {$scrollleft + 2};
		#line {ignore} {#showme {<F$pal[chat]>$casttext} {$barrow} {$castcol}}
		}
	}

#nop {One colour for every panel frame AND its tab label, so the two can}
#nop {never drift. 101040 is the navy #draw was already using for an}
#nop {uncoloured box - passing it explicitly changes nothing on screen and}
#nop {means the labels can be given the same tag rather than guessing at the}
#nop {default. Retune the palette's "edge" entry to recolour every panel edge.}

#variable {paneledge} {<F101040>}

#nop {The tab labels have their own colour again - a dark gold, chosen by}
#nop {Kenny. Kept as its own variable rather than folded back into}
#nop {$paneledge so the frame and the titles can be retuned separately.}
#nop {Both are reset from $pal by themeapply; these are the pre-theme values.}

#variable {panelhead} {<F806100>}

#nop {Alias feedback lines ("Auto-attack ON", "Mapper ON" ...) print in the same}
#nop {gold: every #showme that reports an alias's result starts with $panelhead,}
#nop {here and in map.tin, so retuning the header colour retunes them too. The}
#nop {old bright green (<afa>) was too loud on the light grey background.}

#nop {pandraw repaints the borders and both halves without touching geometry.}
#nop {The full-width line on $barrow (the row #split reserves above the input)}
#nop {is the border separating the input from the main content; drawing it here}
#nop {means it is restored within a second if anything overwrites it. It is a}
#nop {#showme of $barline (built in relayout) rather than #draw, so it can carry}
#nop {an explicit charcoal colour tag.}

#alias {pandraw} {
	castdraw;
	bossdraw;
	leftdraw;
	#if {$socpanel == 1} {
		#var {socdrawbot} {$socboxbot};
		#if {$msdppanel == 0} {
			#var {socdrawbot} {-1}
			};
		#draw {$paneledge} {box} {$socboxtop} {$panleft} {$socdrawbot} {$laycols};
		#line {ignore} {#showme {${panelhead}[ Socials ]} {$socboxtop} {$pancol}};
		socdraw
		};
	#if {$msdppanel == 1} {
		#draw {$paneledge} {box} {$msdpboxtop} {$panleft} {-1} {$laycols};
		#line {ignore} {#showme {${panelhead}[ MSDP ]} {$msdpboxtop} {$pancol}};
		msdpdraw
		};
	inputpaint
	}

#nop {=== Left column: Info box + HUD ===}

#nop {Bottom half is the HUD: one progress bar per stat with the current/total}
#nop {figures beneath it, fed from the $msdp[] cache. Fixed bar colours - HP}
#nop {red, Stam blue, Moves green - then Tactics, OB/DB/PB and Speed as text}
#nop {(server names: TACTIC, OFFENSIVE_BONUS, DODGE, PARRY, ATTACK_SPEED).}
#nop {When fighting, an opponent gauge (dark red, matching the server's own}
#nop {gauge colour) sits just above the XP bar with the foe's name, level and}
#nop {health percent underneath and a three row crossed-swords icon at the}
#nop {right hand end; OPPONENT_HEALTH is already a percentage and}
#nop {the server clears the name when combat ends, which blanks those rows.}
#nop {The XP bar is violet, stuck to the bottom of the box, and shows progress}
#nop {through the current level - the server pushes EXPERIENCE as xp REMAINING}
#nop {to next level and EXPERIENCE_MAX as the level's full span (comm.cpp}
#nop {msdp_update), so gained = max - left.}
#nop {The top half is an empty Info box for future use.}

#nop {Top box: world time (WORLD_TIME, minus its dangling "on"), the weather}
#nop {sentence (WEATHER) wrapped beneath it on rows 3-6, then the map picture}
#nop {from row 7 down to the box edge (mapdraw in map.tin, only while the}
#nop {mapper is loaded - $mapvnum exists - and on a mapped room). Room name,}
#nop {vnum, terrain and exits are NOT shown here; the feed has them.}
#nop {Interior is blanked each redraw so shrinking text leaves no tails.}

#alias {infodraw} {
	#if {$leftpanel == 1} {
		#var {inforow} {2};
		#while {$inforow < $leftmid1} {
			#line {ignore} {#showme {$leftblank} {$inforow} {$leftcol}};
			#math {inforow} {$inforow + 1}
			};
		#var {infotime} {};
		#if {&msdp[WORLD_TIME] > 0} {
			#var {infotime} {$msdp[WORLD_TIME]};
			#replace {infotime} { on } {}
			};
		#format {infotime} {$leftfmt} {$infotime};
		#line {ignore} {#showme {<F$pal[text]>$infotime} {2} {$leftcol}};
		#var {infoweather} {};
		#if {&msdp[WEATHER] > 0} {
			#var {infoweather} {$msdp[WEATHER]}
			};
		#format {infowrap} {%w} {{$infoweather}{$leftwidth}};
		#var {inforow} {3};
		#foreach {$infowrap[]} {infopiece} {
			#if {$inforow < 7} {
				#format {infopiece} {$leftfmt} {$infopiece};
				#line {ignore} {#showme {<F$pal[say]>$infopiece} {$inforow} {$leftcol}};
				#math {inforow} {$inforow + 1}
				}
			};
		#math {maprows} {$leftmid1 - 7};
		#if {$maprows >= 3 && &{mapvnum} > 0} {
			mapdraw {$maprows} {$leftwidth} {7} {$leftcol}
			};
		inputpaint
		}
	}

#alias {leftdraw} {
	#if {$leftpanel == 1} {
		#draw {$paneledge} {box} {1} {1} {$leftmid1} {$leftcols};
		#line {ignore} {#showme {${panelhead}[ Info ]} {1} {$leftcol}};
		infodraw;
		#draw {$paneledge} {box} {$leftmid1} {1} {$leftmid2} {$leftcols};
		#line {ignore} {#showme {${panelhead}[ Opponent ]} {$leftmid1} {$leftcol}};
		oppdraw;
		#draw {$paneledge} {box} {$leftmid2} {1} {-1} {$leftcols};
		#line {ignore} {#showme {${panelhead}[ HUD ]} {$leftmid2} {$leftcol}};
		huddraw
		}
	}

#nop {hudnum fetches one MSDP number into $hudnum, 0 when absent or empty.}

#alias {hudnum} {
	#var {hudnum} {0};
	#if {&msdp[%1] > 0} {
		#if {"$msdp[%1]" != ""} {
			#var {hudnum} {$msdp[%1]}
			}
		}
	}

#nop {hudstr fetches one MSDP string into $hudstr, empty when absent.}

#alias {hudstr} {
	#var {hudstr} {};
	#if {&msdp[%1] > 0} {
		#var {hudstr} {$msdp[%1]}
		}
	}

#nop {hudgauge draws a bar row on its own, for a stat whose caption is not}
#nop {"cur/max". %1 percent, %2 row offset, %3 colour, %4 an optional}
#nop {marker drawn to the right of the bar, which costs the bar two cells.}

#alias {hudgauge} {
	#var {hudpct} {%1};
	#if {$hudpct > 100} {
		#var {hudpct} {100}
		};
	#if {$hudpct < 0} {
		#var {hudpct} {0}
		};
	#var {hudgw} {$hudbarw};
	#if {"%4" != ""} {
		#math {hudgw} {$hudbarw - 2}
		};
	#math {hudfill} {$hudgw * $hudpct / 100};
	#math {hudrest} {$hudgw - $hudfill};
	#var {hudf} {$hudfullpre[$hudfill]};
	#var {hudr} {$hudemptypre[$hudrest]};
	#math {hudline} {$hudbase + %2};
	#if {$hudline < $leftbot} {
		#line {ignore} {#showme {%3$hudf<F$pal[empty]>$hudr %3%4} {$hudline} {$leftcol}}
		}
	}

#nop {pctinbar writes a percentage INTO a bar rather than beside it: %1 row,}
#nop {%2 the bar's leftmost column, %3 its width in cells, %4 the percentage,}
#nop {%5 the bar's fill colour as a bare hex triplet (no angle brackets).}
#nop {Only the cells the text covers are written - a padded full width string}
#nop {would blank the blocks either side of it - so this must run AFTER the bar}
#nop {itself is drawn.}

#nop {A terminal cell has no transparency: whatever the text is drawn over is}
#nop {gone, and a cell with no background of its own falls back to the}
#nop {terminal's, which reads as a grey hole punched through the bar. So the}
#nop {figure is drawn ONE CHARACTER AT A TIME and each character carries the}
#nop {background of the cell it lands on - the fill colour over the filled part}
#nop {of the bar, the terminal default over the empty part, where it matches}
#nop {its neighbours already. That is why this walks the string instead of}
#nop {emitting it in one #showme.}

#nop {pctfill over the filled part, pctempty once the bar is under half. The}
#nop {reason is positional, not decorative: the text is centred, so below 50%%}
#nop {the middle of the bar has fallen into the empty band and the fill colour}
#nop {would disappear into it. Light: white on the bar, black on the pale band.}
#nop {Dark: white on the bar too (user request), off-white on the dark band.}
#nop {Shared by the left panel's opponent gauge and the boss banner so the two}
#nop {can never drift apart.}

#nop {A literal per-cent is a SINGLE %% - tintin prints %%%% as two signs.}

#nop {The empty half of a bar is a light shade block ░ drawn in $pal[empty]}
#nop {over the terminal's own background, so its APPARENT colour is a blend,}
#nop {and a digit dropped on it with no background of its own shows the}
#nop {unblended terminal colour - a pale box sitting in the band. Measured off}
#nop {a screenshot: mintty fills ░ at 0.243 coverage, so the band is}
#nop {0.243*empty + 0.757*bg - B4B4B4 on the light theme, 292928 on the dark.}
#nop {That blend is the palette's "band" entry; retune it if empty or bg move.}

#alias {pctinbar} {
	#nop {No padding spaces around the figure: a space is drawn in the terminal};
	#nop {background, so it punched a grey gap through the bar either side of};
	#nop {the text. The digits sit straight on the blocks instead.};
	#var {pctbtext} {%4%};
	#format {pctblen} {%L} {$pctbtext};
	#math {pctbpad} {(%3 - $pctblen) / 2};
	#if {$pctbpad < 0} {
		#var {pctbpad} {0}
		};
	#math {pctbcol} {%2 + $pctbpad};
	#var {pctbfg} {<F$pal[pctfill]>};
	#if {%4 < 50} {
		#var {pctbfg} {<F$pal[pctempty]>}
		};
	#nop {Same fill arithmetic hudgauge and bossbox use, so the boundary the};
	#nop {text is coloured against is the boundary actually drawn.};
	#var {pctbbar} {%5};
	#if {"$pctbbar" == ""} {
		#var {pctbbar} {$pal[boss]}
		};
	#nop {pctbg 0 would drop the background tag entirely, but a terminal cell};
	#nop {has no transparency: the digits then show the terminal colour as a};
	#nop {gap through the bar (seen on the dark theme 2026-09-04), so both};
	#nop {themes paint the matching bar / band colour behind the text.};
	#if {$pal[pctbg] == 1} {
		#var {pctbon} {<B$pctbbar>};
		#var {pctboff} {<B$pal[band]>}
		} {
		#var {pctbon} {};
		#var {pctboff} {}
		};
	#math {pctbfill} {%3 * %4 / 100};
	#if {$pctbfill > %3} {
		#var {pctbfill} {%3}
		};
	#if {$pctbfill < 0} {
		#var {pctbfill} {0}
		};
	#var {pctbrem} {$pctbtext};
	#var {pctbi} {$pctbpad};
	#var {pctbx} {$pctbcol};
	#while {1 == 1} {
		#regexp {$pctbrem} {^{.}{.*}$} {#var {pctbc} {&1};#var {pctbrem} {&2}} {#break};
		#if {$pctbi < $pctbfill} {
			#var {pctbbg} {$pctbon}
			} {
			#var {pctbbg} {$pctboff}
			};
		#nop {The trailing <099> is NOT optional: a positioned #showme emits the};
		#nop {character and then a bare carriage return, with no SGR reset, so a};
		#nop {background set here stays the terminal's active attribute and every};
		#nop {later blank and erase paints in it - the whole screen went red.};
		#line {ignore} {#showme {$pctbbg$pctbfg$pctbc<099>} {%1} {$pctbx}};
		#math {pctbi} {$pctbi + 1};
		#math {pctbx} {$pctbx + 1}
		}
	}

#nop {hudk renders a count in thousands with one decimal: 7523 becomes 7.5k.}
#nop {Tintin has integer maths only, so the decimal is the hundreds digit taken}
#nop {separately - truncated, not rounded, which is what you want for a}
#nop {"still to go" figure. Under a thousand it stays a plain number, because}
#nop {"0.8k" reads worse than "812".}

#alias {hudk} {
	#if {%1 >= 1000} {
		#math {hudkw} {%1 / 1000};
		#math {hudkf} {(%1 %% 1000) / 100};
		#var {hudk} {$hudkw.${hudkf}k}
		} {
		#var {hudk} {%1}
		}
	}

#nop {hudbar draws one stat: the bar row, then "label cur/max" under it.}
#nop {%1 label, %2 current, %3 max, %4 row offset in the box, %5 colour,}
#nop {%6 optional regeneration per tick, appended as (+n),}
#nop {%7 optional text pinned to the RIGHT END of the bar row - the bar is}
#nop {shortened to make room rather than the text being drawn over it.}
#nop {("auto" = green/amber/red by percentage, or an explicit <F......> tag).}

#alias {hudbar} {
	#var {hudpct} {0};
	#if {%3 > 0} {
		#math {hudpct} {%2 * 100 / %3}
		};
	#if {$hudpct > 100} {
		#var {hudpct} {100}
		};
	#if {$hudpct < 0} {
		#var {hudpct} {0}
		};
	#var {hudcolor} {%5};
	#if {"%5" == "auto"} {
		#var {hudcolor} {<F$pal[mv]>};
		#if {$hudpct < 66} {
			#var {hudcolor} {<F$pal[chat]>}
			};
		#if {$hudpct < 33} {
			#var {hudcolor} {<F$pal[hp]>}
			}
		};
	#var {hudsuf} {%7};
	#var {hudbw} {$hudbarw};
	#if {"$hudsuf" != ""} {
		#format {hudsuflen} {%L} {$hudsuf};
		#math {hudbw} {$hudbarw - $hudsuflen - 1}
		};
	#math {hudfill} {$hudbw * $hudpct / 100};
	#math {hudrest} {$hudbw - $hudfill};
	#var {hudf} {$hudfullpre[$hudfill]};
	#var {hudr} {$hudemptypre[$hudrest]};
	#var {hudcap} {%2/%3};
	#if {"%6" != ""} {
		#var {hudcap} {%2/%3 (+%6)}
		};
	#format {hudtext} {%-7s%s} {%1} {$hudcap};
	#format {hudtext} {$leftfmt} {$hudtext};
	#math {hudline} {$hudbase + %4};
	#if {$hudline < $leftbot} {
		#if {"$hudsuf" != ""} {
			#line {ignore} {#showme {$hudcolor$hudf<F$pal[empty]>$hudr<F$pal[text]> $hudsuf} {$hudline} {$leftcol}}
			} {
			#line {ignore} {#showme {$hudcolor$hudf<F$pal[empty]>$hudr} {$hudline} {$leftcol}}
			}
		};
	#math {hudline} {$hudline + 1};
	#if {$hudline < $leftbot} {
		#line {ignore} {#showme {<F$pal[text]>$hudtext} {$hudline} {$leftcol}}
		}
	}

#nop {hudtextrow prints one plain text line in the HUD: %1 row offset, %2 text.}

#alias {hudtextrow} {
	#format {hudtext} {$leftfmt} {%2};
	#math {hudline} {$hudbase + %1};
	#if {$hudline < $leftbot} {
		#line {ignore} {#showme {<F$pal[text]>$hudtext} {$hudline} {$leftcol}}
		}
	}

#nop {The middle box holds the opponent gauge. OPPONENT_HEALTH is already a}
#nop {percentage and the server clears OPPONENT_NAME when combat ends, so the}
#nop {box simply empties itself. The interior is blanked on every redraw so}
#nop {nothing is left behind when a fight finishes.}

#nop {=== Boss banner ===}

#nop {bossregion is the ONLY place the feed's scroll region is set outside}
#nop {margin mode. The banner does not overlay the feed - it takes rows off the}
#nop {top of it, so the region has to start below the banner while it is up and}
#nop {back at row 1 when it comes down.}

#alias {bossregion} {
	#var {bosstopr} {1};
	#if {$bosson == 1} {
		#math {bosstopr} {1 + $bossrows}
		};
	#if {$hwmargins == 0} {
		#screen {scrollregion} {$bosstopr} {$scrollleft} {$panbot} {$scrollright}
		}
	}

#nop {Centre one line in the banner interior. Padding is built from a run of}
#nop {SPACES, which are one byte each, so %%.Ns is safe here in a way it is not}
#nop {for the block glyphs.}

#alias {bosscenter} {
	#format {bossclen} {%L} {%1};
	#math {bosspad} {($bosswidth - $bossclen) / 2};
	#if {$bosspad < 0} {
		#var {bosspad} {0}
		};
	#format {bosspadstr} {%.${bosspad}s} {$bossblank};
	#nop {BRACES REQUIRED: $bosspadstr%%1 parses as a variable NAMED};
	#nop {"bosspadstr%%1", which does not exist, so tintin leaves the whole};
	#nop {token as literal text. ${bosspadstr} ends the name explicitly.};
	#format {bosscentered} {$bossfmt} {${bosspadstr}%1}
	}

#nop {Blank the rows the banner used, so the feed does not inherit its remains}
#nop {when it comes down.}

#alias {bosswipe} {
	#var {bossrow} {1};
	#while {$bossrow <= $bossrows} {
		#line {ignore} {#showme {$bossfeedblank} {$bossrow} {$scrollleft}};
		#math {bossrow} {$bossrow + 1}
		}
	}

#nop {BYTE CLIP: a positioned #showme is cut to the columns remaining on the}
#nop {line counted in BYTES, so a run of three-byte block glyphs is truncated}
#nop {to a third of its length - at column 73 of a 210 column screen only 46 of}
#nop {56 glyphs survived. The bar is therefore emitted in short runs, each}
#nop {well inside the budget. #draw does NOT suffer this (its border is ASCII)}
#nop {and it takes a colour as its first argument, which is how the frame gets}
#nop {its gold without being hand-drawn.}

#alias {bossrunfull} {
	#var {bossn} {%2};
	#while {$bossn > 0} {
		#var {bossk} {$bosschunkw};
		#if {$bossk > $bossn} {
			#var {bossk} {$bossn}
			};
		#line {ignore} {#showme {<F$pal[boss]>$bossfullpre[$bossk]} {%1} {$bosscolx}};
		#math {bosscolx} {$bosscolx + $bossk};
		#math {bossn} {$bossn - $bossk}
		}
	}

#alias {bossrunempty} {
	#var {bossn} {%2};
	#while {$bossn > 0} {
		#var {bossk} {$bosschunkw};
		#if {$bossk > $bossn} {
			#var {bossk} {$bossn}
			};
		#line {ignore} {#showme {<F$pal[empty]>$bossemptypre[$bossk]} {%1} {$bosscolx}};
		#math {bosscolx} {$bosscolx + $bossk};
		#math {bossn} {$bossn - $bossk}
		}
	}

#nop {The percentage is written INTO the bar rather than under it, so it is}
#nop {drawn after the runs and only over the cells it occupies - a full width}
#nop {padded string here would blank the blocks either side of it. It goes on}
#nop {the upper bar row, leaving the lower one unbroken.}

#nop {White over the filled part, black once the bar is under half: at that}
#nop {point the middle of the bar has fallen into the pale empty section and}
#nop {white would disappear into it.}

#alias {bosspctdraw} {
	pctinbar {3} {$bosscol} {$bosswidth} {$bosshp} {$pal[boss]}
	}

#alias {bossbarrow} {
	#var {bosscolx} {$bosscol};
	bossrunfull {%1} {$bossfill};
	bossrunempty {%1} {$bossrest}
	}

#nop {Two rows of bar rather than one - a cell cannot be made taller, so depth}
#nop {is stacked rows. Name centred under it, level centred under that.}

#alias {bossbox} {
	#var {bossfill} {0};
	#if {$bosshp > 0} {
		#math {bossfill} {$bosswidth * $bosshp / 100}
		};
	#if {$bossfill > $bosswidth} {
		#var {bossfill} {$bosswidth}
		};
	#math {bossrest} {$bosswidth - $bossfill};
	#math {bosscol} {$bossleft + 1};
	#draw {<F$pal[bossedge]>} {box} {1} {$bossleft} {$bossrows} {$bossright};
	bossbarrow {2};
	bossbarrow {3};
	bossbarrow {4};
	bosspctdraw;
	bosscenter {$bossname};
	#line {ignore} {#showme {<F$pal[boss]>$bosscentered} {5} {$bosscol}};
	bosscenter {Level $bosslvl};
	#line {ignore} {#showme {<F$pal[text]>$bosscentered} {6} {$bosscol}}
	}

#nop {Raising or lowering the banner changes the feed's height, so the region}
#nop {is re-set ONLY on the transition, never on every redraw.}

#alias {bossdraw} {
	#var {bosswant} {0};
	#if {$bosspanel == 1 && $hwmargins == 0} {
		hudstr {OPPONENT_NAME};
		#var {bossname} {$hudstr};
		hudnum {OPPONENT_LEVEL};
		#var {bosslvl} {$hudnum};
		hudnum {OPPONENT_HEALTH};
		#var {bosshp} {$hudnum};
		#if {"$bossname" != "" && $bosslvl > $bossmin} {
			#var {bosswant} {1}
			}
		};
	#if {$bosswant != $bosson} {
		#var {bosson} {$bosswant};
		bossregion;
		#if {$bosson == 0} {
			bosswipe
			}
		};
	#if {$bosson == 1} {
		bossbox
		}
	}

#nop {Named apart from the $bosson STATE variable on purpose - these are the}
#nop {user-facing toggles, $bosson is whether the banner is currently up.}

#alias {bossbaron}  {#var {bosspanel} {1};bossdraw}
#alias {bossbaroff} {#var {bosspanel} {0};bossdraw}

#alias {oppdraw} {
	#if {$leftpanel == 1} {
		#math {opprow} {$leftmid1 + 1};
		#while {$opprow < $leftmid2} {
			#line {ignore} {#showme {$leftblank} {$opprow} {$leftcol}};
			#math {opprow} {$opprow + 1}
			};
		hudstr {OPPONENT_NAME};
		#var {hudoppname} {$hudstr};
		#nop {While the banner is up the foe is shown there instead, so this box};
		#nop {is left blank rather than saying the same thing twice.};
		#if {$bosson == 1} {
			#var {hudoppname} {}
			};
		#if {"$hudoppname" != ""} {
			hudstr {OPPONENT_LEVEL};
			#var {hudopplvl} {$hudstr};
			hudnum {OPPONENT_HEALTH};
			#var {hudopphp} {$hudnum};
			#var {hudbase} {$opptop};
			hudgauge {$hudopphp} {0} {<F$pal[boss]>} {$hudswords};
			#nop {hudgauge leaves the drawn width in $hudgw - the swords marker};
			#nop {costs it two cells - so centre the figure on that, not on the};
			#nop {full panel width. Same text treatment as the boss banner; the};
			#nop {thickness and the gold frame stay exclusive to the banner.};
			#math {hudline} {$hudbase + 0};
			pctinbar {$hudline} {$leftcol} {$hudgw} {$hudopphp} {$pal[boss]};
			hudtextrow {1} {$hudoppname (lvl $hudopplvl)};
			#var {hudbase} {$hudtop}
			};
		inputpaint
		}
	}

#alias {huddraw} {
	#if {$leftpanel == 1} {
		#var {hudbase} {$hudtop};
		#math {hudrow} {$leftmid2 + 1};
		#while {$hudrow < $leftbot} {
			#line {ignore} {#showme {$leftblank} {$hudrow} {$leftcol}};
			#math {hudrow} {$hudrow + 1}
			};
		hudnum {HEALTH};
		#var {hudhp} {$hudnum};
		hudnum {HEALTH_MAX};
		#var {hudhpm} {$hudnum};
		hudnum {MANA};
		#var {hudst} {$hudnum};
		hudnum {MANA_MAX};
		#var {hudstm} {$hudnum};
		hudnum {MOVEMENT};
		#var {hudmv} {$hudnum};
		hudnum {MOVEMENT_MAX};
		#var {hudmvm} {$hudnum};
		hudnum {HEALTH_REGENERATION};
		#var {hudhpr} {$hudnum};
		hudnum {STAMINA_REGENERATION};
		#var {hudstr2} {$hudnum};
		hudnum {MOVEMENT_REGENERATION};
		#var {hudmvr} {$hudnum};
		hudnum {EXPERIENCE_MAX};
		#var {hudxpm} {$hudnum};
		hudnum {EXPERIENCE};
		#nop {The server pushes EXPERIENCE as the xp still needed for the next};
		#nop {level, so it IS the to-next-level figure - the bar's fill is the};
		#nop {complement of it.};
		#var {hudtnl} {$hudnum};
		#math {hudxp} {$hudxpm - $hudnum};
		#if {$hudxp < 0} {
			#var {hudxp} {0}
			};
		hudnum {TACTIC};
		#var {hudtac} {$hudnum};
		hudnum {OFFENSIVE_BONUS};
		#var {hudob} {$hudnum};
		hudnum {DODGE};
		#var {huddb} {$hudnum};
		hudnum {PARRY};
		#var {hudpb} {$hudnum};
		hudnum {ATTACK_SPEED};
		#var {hudspd} {$hudnum};
		hudnum {SPELL_POWER};
		#var {hudspow} {$hudnum};
		hudnum {SPELL_PEN};
		#var {hudspen} {$hudnum};
		hudnum {WILLPOWER};
		#var {hudwill} {$hudnum};
		hudnum {SPELL_SAVE};
		#var {hudsave} {$hudnum};
		hudnum {SPIRIT};
		#var {hudspirit} {$hudnum};
		hudbar {HP} {$hudhp} {$hudhpm} {0} {<F$pal[hp]>} {$hudhpr};
		hudbar {Stam} {$hudst} {$hudstm} {3} {<F$pal[st]>} {$hudstr2};
		hudbar {Moves} {$hudmv} {$hudmvm} {6} {<F$pal[mv]>} {$hudmvr};
		hudtextrow {9} {OB: $hudob  DB: $huddb  PB: $hudpb};
		#nop {Quoted comparisons on purpose: if a character switch has removed};
		#nop {a flag, tintin leaves it as literal text, which is simply not};
		#nop {equal to "1" rather than blowing up a numeric test. $hudrow walks};
		#nop {down one row per class so the rows stack instead of overwriting.};
		#var {hudrow} {10};
		#if {"$hudmage" == "1"} {
			hudtextrow {$hudrow} {Spell Pow: $hudspow  Pen: $hudspen};
			#math {hudrow} {$hudrow + 1}
			};
		#if {"$hudmystic" == "1"} {
			hudtextrow {$hudrow} {Will: $hudwill  Save: $hudsave  Spirit: $hudspirit};
			#math {hudrow} {$hudrow + 1}
			};
		#if {$hudrow == 10} {
			hudtextrow {$hudrow} {Speed: $hudspd};
			#math {hudrow} {$hudrow + 1}
			};
		hudtextrow {$hudrow} {Tactics: $hudtac};
		#math {hudxpoff} {$leftbot - 2 - $hudtop};
		#if {$hudxpoff < 13} {
			#var {hudxpoff} {13}
			};
		hudk {$hudtnl};
		hudbar {XP} {$hudxp} {$hudxpm} {$hudxpoff} {<F$pal[tell]>} {} {$hudk TNL};
		inputpaint
		}
	}

#alias {lefton} {
	#var {leftpanel} {1};
	relayout
	}

#alias {leftoff} {
	#var {leftpanel} {0};
	relayout
	}

#alias {leftpanelwidth} {
	#var {leftcols} {%1};
	relayout
	}

#nop {The terminal keeps resizing for a moment after #screen maximize, so settle}
#nop {first and lay out once rather than fighting each intermediate size.}

#event {SCREEN RESIZE} {#delay {panresize} {relayout} {0.4}}

#nop {A cheap safety net: at most one repaint per second while output is arriving.}

#variable {panpending} {0}

#event {RECEIVED LINE} {
	inputpaint;
	#if {$panpending == 0} {
		#var {panpending} {1};
		#delay {1.0} {#var {panpending} {0};pandraw}
		}
	}

#nop {Prompts are partial lines; RECEIVED LINE never fires for them, and the}
#nop {prompt is usually the very last thing printed before typing resumes.}

#event {RECEIVED PROMPT} {inputpaint}

#nop {=== Mouse wheel: each region scrolls on its own ===}

#nop {%0 is the row and %1 the column the pointer was over. Left of the column is}
#nop {the main feed, which uses tintin's own scrollback - that repaints inside the}
#nop {scroll region only, so the panels do not move with it.}

#variable {panmrow} {1}
#variable {panmcol} {1}

#event {SCROLLED MOUSE WHEEL UP}   {#var {panmrow} {%0};#var {panmcol} {%1};panscrollup}
#event {SCROLLED MOUSE WHEEL DOWN} {#var {panmrow} {%0};#var {panmcol} {%1};panscrolldown}

#alias {panscrollup} {
	#if {$panmcol > $leftw && $panmcol < $panleft} {#buffer {up} {$panscrolllines}};
	#if {$panmcol >= $panleft && $socpanel == 1 && $panmrow <= $socboxbot} {socscrollup};
	#if {$panmcol >= $panleft && $msdppanel == 1 && $panmrow > $socboxbot} {msdpscrollup}
	}

#alias {panscrolldown} {
	#if {$panmcol > $leftw && $panmcol < $panleft} {#buffer {down} {$panscrolllines}};
	#if {$panmcol >= $panleft && $socpanel == 1 && $panmrow <= $socboxbot} {socscrolldown};
	#if {$panmcol >= $panleft && $msdppanel == 1 && $panmrow > $socboxbot} {msdpscrolldown}
	}

#nop {Keyboard equivalents for the main feed, in case mouse tracking is unwanted.}

#alias {feedtop} {#buffer {home}}
#alias {feedend} {#buffer {end}}

#nop {=== MSDP: bottom half of the right column ===}

#nop {The server only pushes variables whose value changed, so the panel cannot be}
#nop {a log of the last thing that arrived. Every variable is stored in $msdp[NAME]}
#nop {and the panel is a full redraw of that table: every variable that has a value}
#nop {keeps its own row, and an update only repaints the row it changed.}
#nop {*msdp[] is the list of variable NAMES; $msdp[] would return the values.}
#nop {#line ignore stops the panel's own output from being fed back into triggers.}

#event {IAC SB MSDP} {#var {msdp[%0]} {%1};bossdraw;#if {$msdppanel == 1} {msdpdraw};#if {$leftpanel == 1} {huddraw;oppdraw;infodraw}}

#event {IAC WILL MSDP} {#showme {<ffa>MSDP: server offered WILL MSDP}}
#event {IAC DO MSDP} {#showme {<ffa>MSDP: client replied DO MSDP}}

#nop {MSDP tables arrive as nested tables, so $msdp[NAME] renders with braces.}
#nop {Truncating that with #format can cut between a { and its }, which tintin}
#nop {reports as "GET BRACED ARGUMENT: UNMATCHED BRACE" once per redraw. msdpflat}
#nop {turns a table into plain "key=value key=value" text and shows any deeper}
#nop {nesting as (...), so the value handed to #format never contains a brace.}

#alias {msdpflat} {
	#var {msdpval} {$msdp[$msdpname]};
	#if {&msdp[$msdpname][] > 0} {
		#var {msdpval} {};
		#foreach {*msdp[$msdpname][]} {msdpkey} {
			#var {msdpsub} {$msdp[$msdpname][$msdpkey]};
			#if {&msdp[$msdpname][$msdpkey][] > 0} {#var {msdpsub} {(...)}};
			#var {msdpval} {$msdpval$msdpkey=$msdpsub }
			}
		}
	}

#alias {msdpdraw} {
	#if {$msdppanel == 1} {
		#var {msdprow} {0};
		#var {msdpidx} {0};
		#foreach {*msdp[]} {msdpname} {
			#if {"$msdp[$msdpname]" != ""} {
				#math {msdpidx} {$msdpidx + 1};
				#if {$msdpidx > $msdpview && $msdprow < $msdpcap} {
					msdpflat;
					#math {msdprow} {$msdprow + 1};
					#format {msdpn} {$pannfmt} {$msdpname};
					#format {msdpv} {$panvfmt} {$msdpval};
					#math {msdpline} {$msdptop + $msdprow - 1};
					#line {ignore} {#showme {<fca>$msdpn <afa>$msdpv} {$msdpline} {$pancol}}
					}
				}
			};
		#while {$msdprow < $msdpcap} {
			#math {msdprow} {$msdprow + 1};
			#math {msdpline} {$msdptop + $msdprow - 1};
			#line {ignore} {#showme {$panblank} {$msdpline} {$pancol}}
			};
		inputpaint
		}
	}

#nop {msdpview is how many variables are hidden above the top of the box.}

#alias {msdpcount} {
	#var {msdptotal} {0};
	#foreach {*msdp[]} {msdpname} {#if {"$msdp[$msdpname]" != ""} {#math {msdptotal} {$msdptotal + 1}}}
	}

#alias {msdpscrollup} {
	#math {msdpview} {$msdpview - $panscrolllines};
	#if {$msdpview < 0} {#var {msdpview} {0}};
	msdpdraw
	}

#alias {msdpscrolldown} {
	msdpcount;
	#math {msdpmax} {$msdptotal - $msdpcap};
	#if {$msdpmax < 0} {#var {msdpmax} {0}};
	#math {msdpview} {$msdpview + $panscrolllines};
	#if {$msdpview > $msdpmax} {#var {msdpview} {$msdpmax}};
	msdpdraw
	}

#alias {msdpon} {#var {msdppanel} {1};relayout}
#alias {msdpoff} {#var {msdppanel} {0};relayout}

#alias {msdpvars} {#showme {<ffa>Captured MSDP variables:};#showme {*msdp[]}}

#nop {=== Socials: top half of the right column ===}

#nop {A rolling log of every social - mine and other players' - oldest at the top,}
#nop {keeping $sochist lines of history that the wheel scrolls back through. The}
#nop {lines still print in the main window with their usual highlight colours.}
#nop {socadd takes its input from $soccolor and $soctmp rather than from arguments,}
#nop {so player text containing braces or semicolons can never be reparsed.}
#nop {Lines are wrapped and padded to the panel width as they are added, so a}
#nop {redraw is a straight overwrite of each row with no leftover tails.}

#alias {socadd} {
	#format {socwrap} {%w} {{$soctmp}{$panwidth}};
	#foreach {$socwrap[]} {socpiece} {
		#format {socpad} {$panfmt} {$socpiece};
		#list {soclog} {add} {$soccolor$socpad};
		#if {$socview > 0} {#math {socview} {$socview + 1}}
		};
	#while {&soclog[] > $sochist} {
		#list {soclog} {delete} {1};
		#if {$socview > 0} {#math {socview} {$socview - 1}}
		};
	socdraw
	}

#nop {socview is how many lines are hidden below the bottom of the box, so 0 is}
#nop {the live view and new socials keep their place when scrolled back.}

#alias {socdraw} {
	#if {$socpanel == 1} {
		#math {socfirst} {&soclog[] - $soccap - $socview + 1};
		#if {$socfirst < 1} {#var {socfirst} {1}};
		#var {socrow} {0};
		#while {$socrow < $soccap} {
			#math {socrow} {$socrow + 1};
			#math {socline} {$soctop + $socrow - 1};
			#math {socidx} {$socfirst + $socrow - 1};
			#var {soctext} {$panblank};
			#if {$socidx <= &soclog[]} {#var {soctext} {$soclog[$socidx]}};
			#line {ignore} {#showme {$soctext} {$socline} {$pancol}}
			};
		inputpaint
		}
	}

#alias {socscrollup} {
	#math {socmax} {&soclog[] - $soccap};
	#if {$socmax < 0} {#var {socmax} {0}};
	#math {socview} {$socview + $panscrolllines};
	#if {$socview > $socmax} {#var {socview} {$socmax}};
	socdraw
	}

#alias {socscrolldown} {
	#math {socview} {$socview - $panscrolllines};
	#if {$socview < 0} {#var {socview} {0}};
	socdraw
	}

#alias {socon} {#var {socpanel} {1};relayout}
#alias {socoff} {#var {socpanel} {0};relayout}
#alias {socclear} {#var {soclog} {};#var {socview} {0};socdraw}
#alias {socend} {#var {socview} {0};socdraw}

#alias {panelwidth} {#var {pancols} {%1};#var {soclog} {};relayout}

#nop {Channel triggers. %0 is the whole line with colour codes already stripped,}
#nop {so the panel keeps the game's own wording and adds its own channel colour.}
#nop {Verified against RotS src/act_comm.cpp: do_say, do_gsay, do_tell, do_whisper,}
#nop {do_ask, do_page and do_gen_com (narrate / chat / yell / sing).}

#action {You have been idle} {afk}

#action {You say '%1}        {#var {soccolor} {<F$pal[say]>};#var {soctmp} {%0};socadd} {5}
#action {%1 says '%2}        {#var {soccolor} {<F$pal[say]>};#var {soctmp} {%0};socadd} {5}

#action {You tell %1 '%2}    {#var {soccolor} {<F$pal[tell]>};#var {soctmp} {%0};socadd} {5}
#action {%1 tells you '%2}   {#var {soccolor} {<F$pal[tell]>};#var {soctmp} {%0};socadd} {5}

#action {You group-say '%1}  {#var {soccolor} {<F$pal[gsay]>};#var {soctmp} {%0};socadd} {5}
#action {%1 group-says '%2}  {#var {soccolor} {<F$pal[gsay]>};#var {soctmp} {%0};socadd} {5}

#action {You narrate '%1}    {#var {soccolor} {<F$pal[narr]>};#var {soctmp} {%0};socadd} {5}
#action {%1 narrates '%2}    {#var {soccolor} {<F$pal[narr]>};#var {soctmp} {%0};socadd} {5}

#action {You chat '%1}       {#var {soccolor} {<F$pal[chat]>};#var {soctmp} {%0};socadd} {5}
#action {%1 chats '%2}       {#var {soccolor} {<F$pal[chat]>};#var {soctmp} {%0};socadd} {5}

#action {You yell '%1}       {#var {soccolor} {<F$pal[tell]>};#var {soctmp} {%0};socadd} {5}
#action {%1 yells '%2}       {#var {soccolor} {<F$pal[tell]>};#var {soctmp} {%0};socadd} {5}

#action {You sing '%1}       {#var {soccolor} {<F$pal[chat]>};#var {soctmp} {%0};socadd} {5}
#action {%1 sings '%2}       {#var {soccolor} {<F$pal[chat]>};#var {soctmp} {%0};socadd} {5}

#action {%1 whispers to you, '%2} {#var {soccolor} {<F$pal[whis]>};#var {soctmp} {%0};socadd} {5}
#action {%1 asks you '%2}         {#var {soccolor} {<F$pal[whis]>};#var {soctmp} {%0};socadd} {5}

#action {You page %1 with '%2}    {#var {soccolor} {<F$pal[page]>};#var {soctmp} {%0};socadd} {5}
#action {*%1* pages, '%2}         {#var {soccolor} {<F$pal[page]>};#var {soctmp} {%0};socadd} {5}
#action {*%1* beeps you!}         {#var {soccolor} {<F$pal[page]>};#var {soctmp} {%0};socadd} {5}

#nop {=== Socials ===}

#nop {socials.tin is generated from the server's own lib/misc/socials file}
#nop {and carries an action for every social in the game, in both the form}
#nop {you see when you perform one and the form you see when someone else}
#nop {does. It is ~900 actions, which measured at roughly a third of a}
#nop {millisecond per line of output - a few percent of one core even during}
#nop {heavy combat spam - but socialsoff unloads the class if it ever gets}
#nop {in the way, and socialson brings it back.}

#read {socials.tin}

#alias {socialson} {
	#class {socials} {kill};
	#read {socials.tin};
	#showme {${panelhead}Social capture on}
	}

#alias {socialsoff} {
	#class {socials} {kill};
	#showme {${panelhead}Social capture off}
	}

#nop {=== Skill / spell timer ===}

#nop {There is no "you start" message for most timed actions - bash and}
#nop {ambush simply go quiet - so the start is detected from the server's}
#nop {own wait wheel instead. While a character waits, the server writes one}
#nop {\r|\r packet per remaining beat (comm.cpp), and those arrive as raw}
#nop {packets of length 1, which nothing else in the stream matches. Each}
#nop {one is a beat actually elapsed on the server, so the count is real}
#nop {rather than a local guess. The total comes from skills.tin, keyed on}
#nop {the command just sent. Needs "set spinner" ON in game.}

#read {skills.tin}

#nop {The practice list is the authoritative source: it prints each skill with}
#nop {the time THIS character actually takes, already divided down by casting}
#nop {proficiency. Run "prac" once after login and every timed skill is known}
#nop {exactly, with no guessing and nothing inferred from play.}

#nop {A line looks like:}
#nop {  bash                       (Mastered)  ( 12 time)}
#nop {  magic missile              (Mastered)  (  5 time,     6 stamina)}
#nop {Parentheses are not usable in an action pattern, so the action grabs}
#nop {everything before " time" and the parser takes the name up to the first}
#nop {bracket and the number off the end. A line with no trailing number - say}
#nop {somebody asking what time it is - yields nothing and is ignored.}

#variable {ptime} {}
#variable {pracraw} {}
#variable {pracname} {}
#variable {practime} {}
#variable {praccount} {0}

#action {%1 time%2} {#var {pracraw} {%1};pracparse} {6}

#alias {pracparse} {
	#var {pracname} {};
	#var {practime} {};
	#nop {The character class ends on a letter, so the padding before the};
	#nop {bracket is left out and no space stripping step is needed. A #format};
	#nop {space strip was used here and had to go: escaped for use inside an};
	#nop {alias it came through as literal text in the real client, and every};
	#nop {skill was then filed under that one bogus key. Only NUMBERED};
	#nop {arguments need escaping - format letters must not be escaped.};
	#regexp {$pracraw} {^{([A-Za-z' -]*[A-Za-z])}} {#var {pracname} {&1}};
	#regexp {$pracraw} {{(\d+)}$} {#var {practime} {&1}};
	#if {"$pracname" != "" && "$practime" != ""} {
		#var {ptime[$pracname]} {$practime};
		#math {praccount} {$praccount + 1}
		}
	}

#alias {practimes} {
	#showme {${panelhead}Times learned from the practice list: &ptime[]};
	#showme {*ptime[]}
	}

#nop {skills.tin holds the server's raw beats, which is exact for combat skills}
#nop {but too high for spells - those are divided down by casting proficiency.}
#nop {It is only a fallback; the practice list below is authoritative. Note that}
#nop {either only works when the command carries the official skill name, so}
#nop {client side aliases should expand to "bash $target", "cast 'fireball'"}
#nop {and so on - an in-game alias is expanded server side and never reaches}
#nop {the client. castinfo reports what a command resolved to.}

#variable {castx} {0}
#variable {casty} {0}
#variable {castkey} {}
#variable {castraw} {}
#variable {castsent} {}
#variable {castalt} {}
#variable {castmatch} {}
#variable {castfound} {0}
#variable {castgen} {0}
#variable {castarmed} {0}
#variable {caststamp} {0}
#variable {castnow} {0}
#variable {castel} {0}
#variable {aacount} {0}
#variable {castplen} {0}
#variable {castslen} {0}
#variable {castalive} {0}
#variable {castsaw} {0}
#variable {castboundary} {1}
#variable {castlasttext} {0}
#variable {castgap} {0}
#variable {castpend} {0}
#variable {castheld} {0}
#variable {castholdat} {0}
#variable {castholdnow} {0}
#variable {castholdel} {0}
#variable {castqueue} {}

#nop {Arm the total from the command being sent: a quoted spell name wins}
#nop {over the first word, so "cas 'magic missile' orc" keys on the spell.}
#nop {Captures from #regexp arrive in &1, not %1 - and inside an alias the}
#nop {%1 in the PATTERN has to be written %%1 or the alias eats it first.}

#alias {castlook} {
	#if {"%1" != ""} {
		#if {&ptime[%1] > 0} {
			#var {castfound} {$ptime[%1]};
			#var {castmatch} {%1}
			} {
			#if {&beats[%1] > 0} {
				#var {castfound} {$beats[%1]};
				#var {castmatch} {%1}
				}
			}
		}
	}

#alias {castarm} {
	#nop {A blank line ends a cast: process_input calls break_spell the moment};
	#nop {it sees an empty line from a character with AFF_WAITWHEEL set};
	#nop {(comm.cpp ~1887). That is a client side certainty, so the readout};
	#nop {goes at once rather than waiting to notice the silence.};
	#format {castslen} {%L} {$castraw};
	#if {$castslen == 0} {
		#if {$casty > 0} {
			castclear
			};
		#return
		};
	#var {castsent} {$castraw};
	#var {castkey} {};
	#var {castalt} {};
	#var {castmatch} {};
	#nop {Braced patterns are raw regular expressions. They matter here because};
	#nop {the sent line carries a carriage return - a plain %%1 swallows it and};
	#nop {the key never matches the table, which is why one word commands like};
	#nop {hide silently showed no total.};
	#regexp {$castsent} {^{[a-zA-Z]+}} {#var {castkey} {&1}};
	#regexp {$castsent} {^{[a-zA-Z ]+}} {#var {castalt} {&1}};
	#regexp {$castsent} {'{[^']+}'} {#var {castkey} {&1};#var {castalt} {}};
	#var {castfound} {0};
	castlook {$castkey};
	#if {$castfound == 0} {
		castlook {$castalt}
		};
	#if {"$castmatch" == ""} {
		#var {castmatch} {$castkey}
		};
	#if {$castfound == 0} {
		#return
		};
	#nop {A command sent while a wait is already running does not interrupt it -};
	#nop {the server queues the input and serves it when the current action};
	#nop {finishes, so the readout queues it too and gives it its own count};
	#nop {rather than letting the figures run on past the first total.};
	#nop {castheld means the readout is only holding a finished total, so the};
	#nop {action itself is over and the new one starts at once. A genuinely};
	#nop {running action queues instead, the way the server queues the input.};
	#if {($casty > 0 && $castheld == 0) || $castpend > 0} {
		#if {&castqueue[] < 5} {
			#list {castqueue} {add} {$castfound}
			};
		#return
		};
	caststart {$castfound}
	}

#nop {The count is driven by the clock, not by the spinner packets. The server}
#nop {serves waits on its 4 Hz pulse (OPT_USEC 250000 in comm.cpp), so a beat}
#nop {is a flat quarter second and an N beat action takes N of them. Counting}
#nop {spinner packets instead loses beats whenever the server coalesces a tick}
#nop {with other output - someone walking into the room - because the packet is}
#nop {then no longer one character wide.}

#nop {castgen invalidates the ticks still in flight from an earlier action:}
#nop {every scheduled tick carries the generation it was issued under and}
#nop {returns quietly if that no longer matches. Unnamed delays are used on}
#nop {purpose - #undelay on a named one behaves differently between builds.}

#nop {The count is anchored to the server, not to the moment of typing. Between}
#nop {the two there is a whole pulse of alignment - the wait loop runs BEFORE the}
#nop {input loop, so the first decrement is the pulse AFTER the one that read the}
#nop {command - plus the round trip, which measured about three quarters of a}
#nop {second in total. Counting from the keystroke spent that time and the figure}
#nop {hit the total a full second before the cast finished.}

#nop {The anchor is the first packet back after the command. For a spell that is}
#nop {"You start to concentrate.", flushed by process_output on the very pulse}
#nop {the server read the command, so completion falls exactly N beats later. For}
#nop {a skill with no start message it is the first spinner tick instead - the}
#nop {prompt is suppressed while AFF_WAITWHEEL is set (comm.cpp ~line 1067) -}
#nop {which is one pulse later, so those land a quarter second late rather than}
#nop {a second early. castbegin is a one shot latch, so the ticks that follow do}
#nop {not re-anchor it, and a fallback fires it anyway if nothing comes back at}
#nop {all - with the spinner off a skill would otherwise sit on 1 forever.}

#alias {caststart} {
	#math {castgen} {$castgen + 1};
	#var {casty} {%1};
	#var {castx} {1};
	#var {castheld} {0};
	#var {castarmed} {0};
	#var {castplen} {0};
	#var {castpend} {0};
	#var {castalive} {0};
	#var {castsaw} {0};
	#var {castboundary} {1};
	castdraw;
	#delay {0.75} {castbegin {0}}
	}

#nop {%%1 is 1 when the anchor is a bare spinner tick. The server sends the}
#nop {first tick a whole pulse AFTER the one that read the command, so that}
#nop {stamp is back dated by a beat. 0 is the start message, which is flushed}
#nop {on the pulse that read the command and needs no correction.}

#alias {castbegin} {
	#if {$castarmed == 1} {
		#return
		};
	#if {$casty == 0 && $castpend == 0} {
		#return
		};
	#var {castarmed} {1};
	#format {caststamp} {%U};
	#if {%1 == 1} {
		#math {caststamp} {$caststamp - 250000}
		};
	#nop {A chained action waits here rather than starting on a timer, so it};
	#nop {takes over only once the server has actually begun it.};
	#if {$castpend > 0} {
		#math {castgen} {$castgen + 1};
		#var {casty} {$castpend};
		#var {castpend} {0}
		};
	#var {castheld} {0};
	#var {castx} {1};
	castdraw;
	#delay {0.1} {casttick {$castgen}}
	}

#nop {The two real anchors. A spell announces itself - spell_pa.cpp:756 is the}
#nop {only place that line is sent - and a skill with no start message betrays}
#nop {its first beat as a bare one character spinner packet. Nothing else arms}
#nop {the count, so the completion burst of the PREVIOUS action in a chain}
#nop {cannot be mistaken for the start of the next one.}

#nop {A one character packet is a spinner tick. It anchors a count that is}
#nop {still waiting for one, and for a count already running it is the}
#nop {HEARTBEAT: break_spell (comm.cpp:1756) just zeroes the wait and prints}
#nop {nothing at all, so the only evidence a cast was cut short is that the}
#nop {ticks stop. This costs a #format per packet while a cast is running and}
#nop {nothing the rest of the time.}

#event {RECEIVED OUTPUT} {
	#if {$casty > 0 || $castpend > 0} {
		#format {castplen} {%L} {%0};
		#nop {ANY packet counts as a sign of life, not just a bare tick. The};
		#nop {server writes the wheel unbuffered and then flushes whatever else};
		#nop {the pulse produced, so the moment a fight starts talking - a hit};
		#nop {message, an msdp update - the client reads them as ONE packet and};
		#nop {the tick stops being one character wide. Watching only for bare};
		#nop {ticks meant the readout was wiped 0.6 s into any noisy cast.};
		#format {castalive} {%U};
		#if {$castplen == 1} {
			#nop {A bare tick is still what ARMS the watchdog, so a character};
			#nop {with the in-game spinner off is never cancelled by silence};
			#nop {that was never going to be broken.};
			#var {castsaw} {1};
			#if {$castarmed == 0 && $castboundary == 1} {
				castbegin {1}
				}
			} {
			#format {castlasttext} {%U};
			#var {castboundary} {1}
			}
		}
	}

#nop {The server sends this only on the pulse it reads a cast command, so if}
#nop {it arrives while a count is still running with another action queued,}
#nop {that count's action has just ended THIS instant. Finishing the segment}
#nop {here rather than when the clock says so both shows its total at the real}
#nop {completion and hands the next segment a true anchor, whichever side of}
#nop {the completion the client's own count happened to fall on.}

#action {You start to concentrate} {castconc}

#alias {castconc} {
	#if {$castarmed == 1 && $casty > 0 && &castqueue[] > 0} {
		#var {castx} {$casty};
		castdraw;
		castsegdone {$castgen}
		};
	#if {$castarmed == 0} {
		castbegin {0}
		}
	}

#nop {The figure is read off the anchor stamp rather than added up hop by hop.}
#nop {Each #delay fires a few milliseconds late and over fifteen hops that came}
#nop {to a tenth of a second, enough to miss the completion it is meant to land}
#nop {on. Polling faster than a beat and only redrawing when the figure actually}
#nop {changes keeps the screen work at the same four draws a second.}

#alias {casttick} {
	#if {%1 != $castgen || $castarmed == 0 || $casty == 0} {
		#return
		};
	#format {castnow} {%U};
	#nop {Two beats of silence with the wheel running means the wait is gone -};
	#nop {damaged, interrupted, whatever. castalive is only consulted once a};
	#nop {tick has actually been seen, so with the in game spinner switched off};
	#nop {the count simply runs to its total as before instead of being killed};
	#nop {by a heartbeat that was never going to arrive.};
	#if {$castsaw == 1} {
		#math {castgap} {$castnow - $castalive};
		#if {$castgap > 600000} {
			castclear;
			#return
			}
		};
	#math {castel} {($castnow - $caststamp) / 250000};
	#if {$castel < 1} {
		#var {castel} {1}
		};
	#if {$castel > $casty} {
		#var {castel} {$casty}
		};
	#nop {Redrawn on EVERY poll, not only when the figure changes. The readout};
	#nop {sits on the row #split reserves and tintin repaints that row itself};
	#nop {whenever it prints a line - a mob walking in, a social, anything - so};
	#nop {without this the figure and the spinner vanish until the next beat.};
	#nop {Doing it from the count's own poll keeps it OUT of the received line};
	#nop {events, which is where an earlier attempt at this broke up-arrow.};
	#var {castx} {$castel};
	castdraw;
	#if {$castx >= $casty} {
		castsegdone {$castgen}
		} {
		#delay {0.1} {casttick {$castgen}}
		}
	}

#nop {The count reaches the total on the LAST beat, which the server then spends}
#nop {actually completing the action - and the command only reached the server}
#nop {part way into a pulse, plus the round trip. So the figure legitimately}
#nop {lands on the total a moment before the cast finishes, and clearing it}
#nop {straight away made the readout vanish while the cast was still running.}
#nop {The total is HELD instead, until the next action starts or the hold times}
#nop {out. castheld also tells castarm the readout is idle, so a command typed}
#nop {during the hold starts at once rather than queueing behind nothing.}

#alias {castsegdone} {
	#if {%1 != $castgen} {
		#return
		};
	#math {castgen} {$castgen + 1};
	#nop {The total that was just reached is held either way. If something is};
	#nop {queued it is armed for its OWN anchor rather than started from this};
	#nop {moment: this moment is only the client's PREDICTION of the end, and};
	#nop {chaining off a prediction compounds its error down the chain. Server};
	#nop {pulses can run long but never short - timediff clamps an overrun to a};
	#nop {zero sleep and never makes one up - so that error is one directional};
	#nop {and each link finishes a little further ahead of the real cast.};
	#var {castheld} {1};
	#format {castholdat} {%U};
	#if {&castqueue[] > 0} {
		#var {castpend} {$castqueue[1]};
		#list {castqueue} {delete} {1};
		#var {castarmed} {0};
		#var {castplen} {0};
		#nop {Whether the previous action's completion has ALREADY been seen};
		#nop {decides whether a tick may anchor the new segment. If the last};
		#nop {thing in was real text, the boundary is behind us and the next};
		#nop {tick belongs to the new action. If the last thing in was a tick,};
		#nop {the completion has not landed yet and the trailing tick of the};
		#nop {OLD action is still to come - accepting it would anchor the new};
		#nop {segment half a second early, and that error feeds the next};
		#nop {handover, which is what made a chain drift further ahead with};
		#nop {every cast.};
		#if {$castlasttext > $castalive} {
			#var {castboundary} {1}
			} {
			#var {castboundary} {0}
			};
		#var {castalive} {0};
		#var {castsaw} {0}
		};
	#delay {0.1} {castlinger}
	}

#nop {The hold is timed off its own stamp rather than trusted to the delay that}
#nop {scheduled it: #delay substitutes variables when it FIRES, so a leftover}
#nop {linger from an earlier action would otherwise wipe a newer total.}

#nop {The hold repaints on the same cadence as the count, because the}
#nop {completion message lands at exactly the moment the total is being shown}
#nop {and would otherwise wipe it off the row straight away.}

#alias {castlinger} {
	#if {$castheld == 1} {
		castdraw;
		#format {castholdnow} {%U};
		#math {castholdel} {$castholdnow - $castholdat};
		#if {$castholdel >= 1100000} {
			castclear
			} {
			#delay {0.1} {castlinger}
			}
		}
	}

#alias {castclear} {
	#math {castgen} {$castgen + 1};
	#list {castqueue} {clear};
	#var {castheld} {0};
	#var {castarmed} {0};
	#var {castpend} {0};
	#var {castx} {0};
	#var {casty} {0};
	castdraw
	}

#nop {Telnet debug prints raw negotiation to the main screen; keep it opt-in.}

#alias {castinfo} {
	#showme {${panelhead}sent=[$castsent] key=[$castkey] alt=[$castalt] matched=[$castmatch]};
	#showme {${panelhead}total=[$casty] beat=[$castx] held=[$castheld] queued=[$castqueue[%*]] practice=[&ptime[]] table=[&beats[]]}
	}

#nop {=== Auto-attack ===}

#nop {The mob triggers live in auto-attack.tin, wrapped in the autoattack}
#nop {class. Switching it off is a class kill, switching it on re-reads the}
#nop {file after killing it - so turning it on twice replaces the triggers}
#nop {rather than doubling them, and turning it off leaves nothing behind.}
#nop {Off by default: nothing reads auto-attack.tin at startup.}

#alias {aa-on} {
	#class {autoattack} {kill};
	#read {auto-attack.tin};
	#class {autoattack} {size} {aacount};
	#showme {${panelhead}Auto-attack ON - $aacount mobs armed.}
	}

#alias {aa-off} {
	#class {autoattack} {kill};
	#showme {${panelhead}Auto-attack OFF.}
	}

#alias {auto-attack} {
	#class {autoattack} {size} {aacount};
	#if {$aacount > 0} {
		#showme {${panelhead}Auto-attack is ON - $aacount mobs armed.};
		#class {autoattack} {list}
		} {
		#showme {${panelhead}Auto-attack is OFF.}
		}
	}

#nop {=== Mapper ===}

#nop {The mapper lives in map.tin, wrapped in the mapper class, on the same}
#nop {pattern as auto-attack: map-on kills the class then reads the file (so it}
#nop {is safe to run twice), map-off saves the map and kills the class. Reading}
#nop {the file loads bin/rots.map; the commands (mapping, goto, mapmark ...)}
#nop {only exist while it is on. Switched on automatically by the CHARACTER_NAME}
#nop {login event above; map-off turns it off until the next login.}

#alias {map-on} {
	#class {mapper} {kill};
	#read {map.tin};
	#showme {${panelhead}Mapper ON - 'mapping' toggles recording, 'goto <landmark>' walks.}
	}

#alias {map-off} {
	#class {mapper} {size} {mapcount};
	#if {$mapcount > 0} {mapsave};
	#class {mapper} {kill};
	#showme {${panelhead}Mapper OFF.}
	}

#alias {mapper} {
	#class {mapper} {size} {mapcount};
	#if {$mapcount > 0} {
		#showme {${panelhead}Mapper is ON - recording is $mapcapture (1 = on), room $mapvnum.};
		#map info
		} {
		#showme {${panelhead}Mapper is OFF.}
		}
	}

#alias {telnetdebugon} {#config {DEBUG TELNET} {ON}}
#alias {telnetdebugoff} {#config {DEBUG TELNET} {OFF}}

#nop {=== Command history ===}

#nop {Keep one-letter commands out of the up-arrow history - j, x, b and the}
#nop {rest are quicker to retype than to scroll past. histmin is the shortest}
#nop {command worth remembering; raise it to 3 to drop two-letter ones too.}

#nop {RECEIVED INPUT is the only event that sees the RAW TYPED LINE: it fires}
#nop {before alias expansion, so typing "cs" reports "cs" rather than the}
#nop {cast command it turns into. SENT OUTPUT reports the expansion and is}
#nop {therefore no use for this.}

#nop {The #delay is NOT optional. RECEIVED INPUT fires BEFORE the line is}
#nop {stored, so deleting straight away removes the PREVIOUS entry - measured,}
#nop {it ate "look north" while keeping "j". Deferring by one pass puts the}
#nop {delete after the store. The one case this gets wrong is several lines}
#nop {arriving in a single read - a pasted block - where the deletes land}
#nop {together and take the newest entries instead.}

#variable {histmin} {2}
#variable {histlen} {0}

#event {RECEIVED INPUT} {
	#format {histlen} {%L} {%0};
	#nop {A bare enter is stored too, and it is what cancels a cast, so it};
	#nop {would otherwise fill the history with blanks. Zero is shorter than};
	#nop {histmin, so the same test covers it.};
	#if {$histlen < $histmin} {
		#delay {0} {#history {delete}}
		}
	}

#nop {=== Input line keys ===}

#nop {The input line is redrawn by tintin in COMMAND COLOR, which defaults to}
#nop {bright green. Plain "blue" here is a safe fallback; themeapply then sets}
#nop {the theme's truecolour ink - if a tintin build rejects the truecolour}
#nop {form, the input stays a sane dark blue instead of green.}

#config {COMMAND COLOR} {blue}

#nop {COLOR PATCH repairs server lines that do not reset their colour. It is}
#nop {not sufficient on its own - the panel repaints also leave colours active -}
#nop {so the inputpaint alias (defined with the panels) is what actually keeps}
#nop {typed text navy.}

#config {COLOR PATCH} {ON}

#nop {The skill/spell spinner (comm.cpp wait_wheel) is sent as bare \r|\r}
#nop {with no newline. Tintin holds unfinished lines, and while a scroll}
#nop {region or split side bar is active it REDRAWS the growing buffer}
#nop {rather than emitting each tick, so the wheel smears instead of}
#nop {animating. Measured: with no bounded region each tick draws as sent;}
#nop {with either a scroll region or #split side bars it accumulates, and}
#nop {PACKET PATCH does not change that. The side panels and the server's}
#nop {own spinner are therefore mutually exclusive - turn the spinner off}
#nop {in game with "set spinner" to keep the feed clean.}

#nop {TinTin's command line is a readline style editor with no concept of a text}
#nop {selection - there is no select/mark operation in #cursor for a macro to drive,}
#nop {so shift+arrow cannot highlight text. What these macros do is stop those keys}
#nop {injecting raw escape text into the input and make them move the cursor the way}
#nop {they would in a normal field. To select text, hold shift and drag with the}
#nop {mouse (mintty's selection, needed while mouse tracking is on).}

#nop {shift+Home and shift+End only reach tintin if mintty's ScrollMod is changed;}
#nop {by default mintty keeps shift+Home/End/arrows for its own scrollback.}

#macro {\e[1;2D} {#cursor backward}
#macro {\e[1;2C} {#cursor forward}
#macro {\e[1;2H} {#cursor home}
#macro {\e[1;2F} {#cursor end}

#nop {Word-wise movement, ctrl and ctrl+shift, as in most editors.}

#macro {\e[1;5D} {#cursor prev word}
#macro {\e[1;5C} {#cursor next word}
#macro {\e[1;6D} {#cursor prev word}
#macro {\e[1;6C} {#cursor next word}

#nop {In place of selecting: ctrl+u clears the line, ctrl+w deletes the word to the}
#nop {left, ctrl+k clears to the right of the cursor.}

#nop {=== Hotkeys (imported from JMC) ===}

#nop {Every JMC profile bound F2 to #connect, so it lives here rather than in}
#nop {each character file. mintty sends \eOQ for F2. Character-specific TAB}
#nop {hotkeys are in the character files.}

#macro {\eOQ} {#session {ReturnOfTheShadow} {rotsmud.org} {3791} {global.tin}}

#nop {=== Command echo ===}

#nop {SENT OUTPUT fires for every command sent to the server, whatever triggered it.}
#nop {The regexp skips telnet negotiation, which is binary and starts with IAC (0xFF).}
#nop {main.tin sets COMMAND ECHO off: in split mode tintin would echo typed commands}
#nop {itself, and this event would then print every one of them a second time.}
#nop {Dark charcoal for the echo - readable on the light grey background, and}
#nop {visually "mine" against the blue server text.}

#variable {cmdecho} {1}

#nop {The sent line carries its CARRIAGE RETURN. Echoing %0 whole printed it}
#nop {too, and the CR plus #showme's own line ending came out as TWO line}
#nop {terminators - "sc\r\r\n" then "\r\n" on the wire - which is what put a}
#nop {blank line under every command typed. The braced capture takes the}
#nop {command up to but not including the CR. The leading \w still skips}
#nop {telnet negotiation, which is binary and starts with IAC (0xFF).}

#event {SENT OUTPUT} {#if {$cmdecho == 1} {#regexp {%0} {^{\w[^\r]*}} {#showme {<F$pal[mute]>&1}}};#var {castraw} {%0};castarm;inputpaint}

#alias {echoon} {#var {cmdecho} {1};#showme {${panelhead}Command echo on}}
#alias {echooff} {#var {cmdecho} {0};#showme {${panelhead}Command echo off}}

#nop {Apply the theme (which ends with relayout) once everything above is}
#nop {defined. The delayed second pass catches the resize that follows}
#nop {#screen maximize in main.tin.}

theme $theme

#delay {0.5} {relayout}
