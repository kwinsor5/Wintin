#nop {Generated from RotS src/consts.cpp: skills[MAX_SKILLS], field 'beats',}
#nop {the heartbeats a skill or spell occupies. The game loop runs 4 passes}
#nop {per second (comm.cpp OPT_USEC 250000), so a beat is a quarter second.}

#nop {Combat skills use beats directly (WAIT_STATE_FULL(ch, skills[X].beats)),}
#nop {while spells scale it down with proficiency - CASTING_TIME in spells.h is}
#nop {(beats * 30) / (30 + prof level) - so for a practised caster the real}
#nop {total is shorter than the figure here and the counter simply clears}
#nop {early. The client cannot know proficiency; MSDP does not carry it.}

#class {skillbeats} {open}

